-- Toggle
--============================================================

function Library:CreateToggle(config)
    config = config or {}

    local callback = config.Callback or function() end

    local state = config.Default == true
    local toggle = {}

    setmetatable(toggle, {
        __index = self,
    })

    local ToggleFrame = Create("Frame", {
        Name = config.Name or "Toggle",

        Size = UDim2.new(1, 0, 0, 34),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        LayoutOrder = config.LayoutOrder or 1,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),
    })

    local Label = Create("TextLabel", {
        Size = UDim2.new(1, -65, 1, 0),
        Position = UDim2.new(0, 11, 0, 0),

        BackgroundTransparency = 1,

        Text = config.Name or "Toggle",
        TextColor3 = Theme.TextPrimary,

        TextSize = 13,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = ToggleFrame,
    })

    local SwitchBG = Create("Frame", {
        Size = UDim2.new(0, 36, 0, 18),
        Position = UDim2.new(1, -47, 0.5, -9),

        BackgroundColor3 = Theme.Track,
        BorderSizePixel = 0,

        Parent = ToggleFrame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    local Knob = Create("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(0, 2, 0.5, -7),

        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,

        Parent = SwitchBG,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    local ClickArea = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),

        BackgroundTransparency = 1,

        Text = "",

        AutoButtonColor = false,

        Parent = ToggleFrame,
    })

    local function UpdateVisual()
        if state then
            Tween(SwitchBG, DEFAULT_TWEEN, {
                BackgroundColor3 = Theme.Accent,
            })

            Tween(Knob, DEFAULT_TWEEN, {
                Position = UDim2.new(1, -16, 0.5, -7),
                BackgroundColor3 = Theme.Background,
            })
        else
            Tween(SwitchBG, DEFAULT_TWEEN, {
                BackgroundColor3 = Theme.Track,
            })

            Tween(Knob, DEFAULT_TWEEN, {
                Position = UDim2.new(0, 2, 0.5, -7),
                BackgroundColor3 = Theme.Accent,
            })
        end
    end

    local function SetState(newState, fireCallback)
        state = newState == true

        UpdateVisual()

        if fireCallback ~= false then
            SafeCallback(callback, state)
        end
    end

    self:_Connect(ClickArea.MouseEnter, function()
        Tween(ToggleFrame, FAST_TWEEN, {
            BackgroundColor3 = Theme.ElementHover,
        })
    end)

    self:_Connect(ClickArea.MouseLeave, function()
        Tween(ToggleFrame, FAST_TWEEN, {
            BackgroundColor3 = Theme.ElementBG,
        })
    end)

    self:_Connect(ClickArea.MouseButton1Click, function()
        SetState(not state, true)
    end)

    SetState(state, false)

    toggle.Frame = ToggleFrame
    toggle.SetState = function(_, value)
        SetState(value, true)
    end

    toggle.GetState = function()
        return state
    end

    toggle.Toggle = function()
        SetState(not state, true)
    end

    return toggle
end

--============================================================
-- Slider
--============================================================

function Library:CreateSlider(config)
    config = config or {}

    local min = tonumber(config.Min) or 0
    local max = tonumber(config.Max) or 100

    if max < min then
        min, max = max, min
    end

    local step = tonumber(config.Step) or 1

    if step <= 0 then
        step = 1
    end

    local default = tonumber(config.Default)

    if default == nil then
        default = min
    end

    local callback = config.Callback or function() end

    local slider = {}

    setmetatable(slider, {
        __index = self,
    })

    local value = math.clamp(default, min, max)

    local SliderFrame = Create("Frame", {
        Name = config.Name or "Slider",

        Size = UDim2.new(1, 0, 0, 47),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        LayoutOrder = config.LayoutOrder or 1,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),
    })

    local Label = Create("TextLabel", {
        Size = UDim2.new(1, -80, 0, 17),
        Position = UDim2.new(0, 11, 0, 4),

        BackgroundTransparency = 1,

        Text = config.Name or "Slider",
        TextColor3 = Theme.TextPrimary,

        TextSize = 13,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = SliderFrame,
    })

    local ValueLabel = Create("TextLabel", {
        Size = UDim2.new(0, 65, 0, 17),
        Position = UDim2.new(1, -73, 0, 4),

        BackgroundTransparency = 1,

        Text = FormatNumber(value),
        TextColor3 = Theme.TextSecondary,

        TextSize = 11,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Right,

        Parent = SliderFrame,
    })

    local Track = Create("Frame", {
        Size = UDim2.new(1, -22, 0, 6),
        Position = UDim2.new(0, 11, 1, -13),

        BackgroundColor3 = Theme.Track,
        BorderSizePixel = 0,

        Parent = SliderFrame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    local Fill = Create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),

        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,

        Parent = Track,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    local Knob = Create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),

        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,

        Parent = Track,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    local function SnapValue(number)
        local snapped = min
            + math.round((number - min) / step) * step

        return math.clamp(snapped, min, max)
    end

    local function SetValue(newValue, fireCallback)
        newValue = tonumber(newValue)

        if not newValue then
            return
        end

        value = SnapValue(newValue)

        local range = max - min

        local ratio

        if range <= 0 then
            ratio = 0
        else
            ratio = (value - min) / range
        end

        Fill.Size = UDim2.new(
            ratio,
            0,
            1,
            0
        )

        Knob.Position = UDim2.new(
            ratio,
            -6,
            0.5,
            -6
        )

        ValueLabel.Text = FormatNumber(value)

        if fireCallback ~= false then
            SafeCallback(callback, value)
        end
    end

    local draggingSlider = false

    local function UpdateFromInput(input)
        if Track.AbsoluteSize.X <= 0 then
            return
        end

        local ratio = (
            input.Position.X
            - Track.AbsolutePosition.X
        ) / Track.AbsoluteSize.X

        ratio = math.clamp(ratio, 0, 1)

        local newValue = min
            + (max - min) * ratio

        SetValue(newValue, true)
    end

    self:_Connect(Track.InputBegan, function(input, gameProcessed)
        if gameProcessed then
            return
        end

        if IsInput(input) then
            draggingSlider = true
            UpdateFromInput(input)
        end
    end)

    self:_Connect(Track.InputEnded, function(input)
        if IsInput(input) then
            draggingSlider = false
        end
    end)

    self:_Connect(UserInputService.InputEnded, function(input)
        if IsInput(input) then
            draggingSlider = false
        end
    end)

    self:_Connect(UserInputService.InputChanged, function(input)
        if draggingSlider and IsMoveInput(input) then
            UpdateFromInput(input)
        end
    end)

    SetValue(value, false)

    slider.Frame = SliderFrame

    slider.SetValue = function(_, newValue)
        SetValue(newValue, true)
    end

    slider.GetValue = function()
        return value
    end

    return slider
end

--============================================================
-- Dropdown
--============================================================

function Library:CreateDropdown(config)
    config = config or {}

    local options = config.Options or {}
    local callback = config.Callback or function() end

    local selectedValue = config.Default

    if selectedValue == nil and #options > 0 then
        selectedValue = options[1]
    end

    local isOpen = false

    local itemHeight = 28
    local padding = 4

    local dropdown = {}

    setmetatable(dropdown, {
        __index = self,
    })

    local totalListHeight = (
        #options * itemHeight
    ) + (
        math.max(0, #options - 1) * 2
    ) + (
        padding * 2
    )

    local DropdownFrame = Create("Frame", {
        Name = config.Name or "Dropdown",

        Size = UDim2.new(1, 0, 0, 33),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        ClipsDescendants = true,

        LayoutOrder = config.LayoutOrder or 1,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),
    })

    local Header = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 33),

        BackgroundTransparency = 1,

        Text = "",

        AutoButtonColor = false,

        Parent = DropdownFrame,
    })

    local Label = Create("TextLabel", {
        Size = UDim2.new(1, -45, 1, 0),
        Position = UDim2.new(0, 11, 0, 0),

        BackgroundTransparency = 1,

        Text = tostring(selectedValue or "Select..."),
        TextColor3 = Theme.TextPrimary,

        TextSize = 13,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = Header,
    })

    local Arrow = Create("TextLabel", {
        Size = UDim2.new(0, 20, 0, 33),
        Position = UDim2.new(1, -30, 0, 0),

        BackgroundTransparency = 1,

        Text = "▼",
        TextColor3 = Theme.TextSecondary,

        TextSize = 10,
        Font = Theme.Font,

        Parent = Header,
    })

    local ListContainer = Create("Frame", {
        Name = "List",

        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 33),

        BackgroundColor3 = Color3.fromRGB(14, 14, 14),
        BorderSizePixel = 0,

        Parent = DropdownFrame,
    }, {
        Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 2),
        }),

        Create("UIPadding", {
            PaddingTop = UDim.new(0, padding),
            PaddingBottom = UDim.new(0, padding),
            PaddingLeft = UDim.new(0, padding),
            PaddingRight = UDim.new(0, padding),
        }),
    })

    ----------------------------------------------------------------
    -- IMPORTANT:
    -- Declare before callbacks so callbacks correctly capture it.
    ----------------------------------------------------------------

    local ToggleDropdown

    ----------------------------------------------------------------
    -- Options
    ----------------------------------------------------------------

    local ItemButtons = {}

    for index, option in ipairs(options) do
        local ItemButton = Create("TextButton", {
            Name = "Option_" .. index,

            Size = UDim2.new(1, 0, 0, itemHeight),

            BackgroundColor3 = Color3.fromRGB(14, 14, 14),
            BorderSizePixel = 0,

            Text = tostring(option),
            TextColor3 = Theme.TextPrimary,

            TextSize = 12,
            Font = Theme.Font,

            AutoButtonColor = false,

            LayoutOrder = index,

            Parent = ListContainer,
        }, {
            Create("UICorner", {
                CornerRadius = UDim.new(0, 2),
            }),
        })

        ItemButtons[index] = ItemButton

        self:_Connect(ItemButton.MouseEnter, function()
            Tween(ItemButton, FAST_TWEEN, {
                BackgroundColor3 = Theme.ElementHover,
            })
        end)

        self:_Connect(ItemButton.MouseLeave, function()
            Tween(ItemButton, FAST_TWEEN, {
                BackgroundColor3 = Color3.fromRGB(14, 14, 14),
            })
        end)

        self:_Connect(ItemButton.MouseButton1Click, function()
            selectedValue = option

            Label.Text = tostring(option)

            SafeCallback(callback, option)

            ToggleDropdown(false)
        end)
    end

    ----------------------------------------------------------------
    -- Dropdown animation
    ----------------------------------------------------------------

    ToggleDropdown = function(state)
        if state == nil then
            state = not isOpen
        end

        state = state == true

        if isOpen == state then
            return
        end

        isOpen = state

        local targetListHeight = state
            and totalListHeight
            or 0

        local targetFrameHeight = state
            and (33 + totalListHeight)
            or 33

        Tween(
            ListContainer,

            TweenInfo.new(
                0.22,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            ),

            {
                Size = UDim2.new(
                    1,
                    0,
                    0,
                    targetListHeight
                ),
            }
        )

        Tween(
            DropdownFrame,

            TweenInfo.new(
                0.22,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            ),

            {
                Size = UDim2.new(
                    1,
                    0,
                    0,
                    targetFrameHeight
                ),
            }
        )

        Tween(
            Arrow,

            TweenInfo.new(
                0.22,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            ),

            {
                Rotation = state and 180 or 0,
                TextColor3 = state
                    and Theme.TextPrimary
                    or Theme.TextSecondary,
            }
        )
    end

    self:_Connect(Header.MouseEnter, function()
        Tween(
            DropdownFrame,
            FAST_TWEEN,
            {
                BackgroundColor3 = Theme.ElementHover,
            }
        )
    end)

    self:_Connect(Header.MouseLeave, function()
        Tween(
            DropdownFrame,
            FAST_TWEEN,
            {
                BackgroundColor3 = Theme.ElementBG,
            }
        )
    end)

    self:_Connect(Header.MouseButton1Click, function()
        ToggleDropdown()
    end)

    ----------------------------------------------------------------
    -- API
    ----------------------------------------------------------------

    dropdown.Frame = DropdownFrame

    dropdown.SetValue = function(_, value)
        for _, option in ipairs(options) do
            if option == value then
                selectedValue = value
                Label.Text = tostring(value)
                return true
            end
        end

        return false
    end

    dropdown.GetSelected = function()
        return selectedValue
    end

    dropdown.Open = function()
        ToggleDropdown(true)
    end

    dropdown.Close = function()
        ToggleDropdown(false)
    end

    dropdown.IsOpen = function()
        return isOpen
    end

    return dropdown
end

--============================================================
-- Keybind
--============================================================

function Library:CreateKeybind(config)
    config = config or {}

    local callback = config.Callback or function() end
    local currentKey = config.Default or Enum.KeyCode.Unknown

    local listening = false

    local keybind = {}

    setmetatable(keybind, {
        __index = self,
    })

    local KeybindFrame = Create("Frame", {
        Name = config.Name or "Keybind",

        Size = UDim2.new(1, 0, 0, 34),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        LayoutOrder = config.LayoutOrder or 1,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),
    })

    local Label = Create("TextLabel", {
        Size = UDim2.new(1, -85, 1, 0),
        Position = UDim2.new(0, 11, 0, 0),

        BackgroundTransparency = 1,

        Text = config.Name or "Keybind",
        TextColor3 = Theme.TextPrimary,

        TextSize = 13,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = KeybindFrame,
    })

    local KeyButton = Create("TextButton", {
        Size = UDim2.new(0, 60, 0, 24),
        Position = UDim2.new(1, -69, 0.5, -12),

        BackgroundColor3 = Theme.Track,
        BorderSizePixel = 0,

        Text = currentKey.Name,

        TextColor3 = Theme.TextSecondary,

        TextSize = 11,
        Font = Theme.Font,

        AutoButtonColor = false,

        Parent = KeybindFrame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),
    })

    local function GetKeyName(key)
        if key == Enum.KeyCode.Unknown then
            return "NONE"
        end

        return key.Name
    end

    local function SetKey(key)
        currentKey = key

        KeyButton.Text = GetKeyName(key)

        SafeCallback(callback, key)
    end

    self:_Connect(KeyButton.MouseEnter, function()
        Tween(KeyButton, FAST_TWEEN, {
            BackgroundColor3 = Theme.ElementHover,
        })
    end)

    self:_Connect(KeyButton.MouseLeave, function()
        Tween(KeyButton, FAST_TWEEN, {
            BackgroundColor3 = Theme.Track,
        })
    end)

    self:_Connect(KeyButton.MouseButton1Click, function()
        listening = true

        KeyButton.Text = "..."

        Tween(KeyButton, FAST_TWEEN, {
            BackgroundColor3 = Theme.Accent,
            TextColor3 = Theme.Background,
        })
    end)

    self:_Connect(UserInputService.InputBegan, function(input, gameProcessed)
        if gameProcessed then
            return
        end

        if listening then
            if input.KeyCode == Enum.KeyCode.Escape then
                listening = false
                KeyButton.Text = GetKeyName(currentKey)

                Tween(KeyButton, FAST_TWEEN, {
                    BackgroundColor3 = Theme.Track,
                    TextColor3 = Theme.TextSecondary,
                })

                return
            end

            if input.KeyCode ~= Enum.KeyCode.Unknown then
                listening = false

                SetKey(input.KeyCode)

                Tween(KeyButton, FAST_TWEEN, {
                    BackgroundColor3 = Theme.Track,
                    TextColor3 = Theme.TextSecondary,
                })
            end

            return
        end

        if currentKey ~= Enum.KeyCode.Unknown
            and input.KeyCode == currentKey then

            SafeCallback(callback, currentKey)
        end
    end)

    keybind.Frame = KeybindFrame

    keybind.SetKey = function(_, key)
        if typeof(key) == "EnumItem"
            and key.EnumType == Enum.KeyCode then

            SetKey(key)
        end
    end

    keybind.GetKey = function()
        return currentKey
    end

    return keybind
end

--============================================================
-- Theme API
--============================================================

function Library:SetTheme(newTheme)
    if typeof(newTheme) ~= "table" then
        return
    end

    for key, value in pairs(newTheme) do
        if Theme[key] ~= nil then
            Theme[key] = value
        end
    end
end

function Library:GetTheme()
    local copy = {}

    for key, value in pairs(Theme) do
        copy[key] = value
    end

    return copy
end

--============================================================
-- Global utility
--============================================================

function Library:Notify(config)
    config = config or {}

    local title = tostring(config.Title or "NOTICE")
    local text = tostring(config.Text or "")
    local duration = tonumber(config.Duration) or 3

    local Notification = Create("Frame", {
        Name = "Notification",

        Size = UDim2.new(0, 280, 0, 72),
        Position = UDim2.new(1, 20, 1, -20),

        AnchorPoint = Vector2.new(1, 1),

        BackgroundColor3 = Theme.Topbar,
        BorderSizePixel = 0,

        Parent = self.ScreenGui,
    }, {
        Create("UICorner", {
            CornerRadius = Theme.CornerRadius,
        }),

        Create("UIStroke", {
            Color = Theme.Stroke,
            Thickness = 1,
        }),
    })

    local TitleLabel = Create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),

        BackgroundTransparency = 1,

        Text = title,
        TextColor3 = Theme.TextPrimary,

        TextSize = 13,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = Notification,
    })

    local BodyLabel = Create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 30),
        Position = UDim2.new(0, 12, 0, 30),

        BackgroundTransparency = 1,

        Text = text,
        TextColor3 = Theme.TextSecondary,

        TextSize = 11,
        Font = Theme.Font,

        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,

        Parent = Notification,
    })

    Notification.Position = UDim2.new(
        1,
        300,
        1,
        -20
    )

    Tween(
        Notification,
        TweenInfo.new(
            0.35,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        {
            Position = UDim2.new(
                1,
                -20,
                1,
                -20
            ),
        }
    )

    task.delay(duration, function()
        if not Notification.Parent then
            return
        end

        local tween = Tween(
            Notification,
            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.In
            ),
            {
                Position = UDim2.new(
                    1,
                    300,
                    1,
                    -20
                ),
            }
        )

        if tween then
            tween.Completed:Wait()
        end

        Notification:Destroy()
    end)

    return Notification
end

--============================================================
-- Return
--============================================================

return Library
