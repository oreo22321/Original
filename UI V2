function Library:CreateWindow(config)
    config = config or {}

    local self = setmetatable({}, Library)

    self.Tabs = {}
    self.Connections = {}
    self.Components = {}
    self.Visible = true
    self.Destroyed = false

    self.Name = config.Name or "SYSTEM"
    self.ToggleKey = config.ToggleKey or Enum.KeyCode.RightShift
    self.Size = config.Size or UDim2.new(0.92, 0, 0.78, 0)

    ----------------------------------------------------------------
    -- ScreenGui
    ----------------------------------------------------------------

    local oldGui = nil

    pcall(function()
        oldGui = CoreGui:FindFirstChild("MonochromeUI")
    end)

    if oldGui then
        oldGui:Destroy()
    end

    local ScreenGui = Create("ScreenGui", {
        Name = "MonochromeUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = false,
        Parent = CoreGui,
    })

    self.ScreenGui = ScreenGui

    ----------------------------------------------------------------
    -- Main Frame
    ----------------------------------------------------------------

    local MainFrame = Create("Frame", {
        Name = "MainFrame",

        Size = self.Size,
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),

        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,

        ClipsDescendants = true,

        Parent = ScreenGui,
    }, {
        Create("UICorner", {
            CornerRadius = Theme.CornerRadius,
        }),

        Create("UIStroke", {
            Color = Theme.Stroke,
            Thickness = 1,
            Transparency = 0.15,
        }),

        Create("UISizeConstraint", {
            MinSize = Vector2.new(320, 240),
            MaxSize = Vector2.new(1100, 750),
        }),
    })

    self.MainFrame = MainFrame

    ----------------------------------------------------------------
    -- Topbar
    ----------------------------------------------------------------

    local Topbar = Create("Frame", {
        Name = "Topbar",

        Size = UDim2.new(1, 0, 0, 44),
        Position = UDim2.new(0, 0, 0, 0),

        BackgroundColor3 = Theme.Topbar,
        BorderSizePixel = 0,

        Parent = MainFrame,
    })

    Create("UIStroke", {
        Color = Theme.Stroke,
        Thickness = 0.5,
        Transparency = 0.6,
        Parent = Topbar,
    })

    local Title = Create("TextLabel", {
        Name = "Title",

        Size = UDim2.new(1, -105, 1, 0),
        Position = UDim2.new(0, 15, 0, 0),

        BackgroundTransparency = 1,

        Text = self.Name,
        TextColor3 = Theme.TextPrimary,

        TextSize = 18,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = Topbar,
    })

    local VersionLabel = Create("TextLabel", {
        Name = "Version",

        Size = UDim2.new(0, 55, 1, 0),
        Position = UDim2.new(1, -100, 0, 0),

        BackgroundTransparency = 1,

        Text = "2.0",
        TextColor3 = Theme.TextSecondary,

        TextSize = 10,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Right,

        Parent = Topbar,
    })

    ----------------------------------------------------------------
    -- Close button
    ----------------------------------------------------------------

    local CloseButton = Create("TextButton", {
        Name = "CloseButton",

        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -40, 0.5, -15),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        Text = "×",
        TextColor3 = Theme.TextPrimary,

        TextSize = 20,
        Font = Theme.Font,

        AutoButtonColor = false,

        Parent = Topbar,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4),
        }),
    })

    ----------------------------------------------------------------
    -- Sidebar
    ----------------------------------------------------------------

    local Sidebar = Create("Frame", {
        Name = "Sidebar",

        Size = UDim2.new(0, 140, 1, -44),
        Position = UDim2.new(0, 0, 0, 44),

        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0,

        Parent = MainFrame,
    })

    local SidebarLayout = Create("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 5),
    })

    Create("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 9),
        PaddingRight = UDim.new(0, 9),
        Parent = Sidebar,
    })

    SidebarLayout.Parent = Sidebar

    self.Sidebar = Sidebar

    local TabContainer = Create("Frame", {
        Name = "TabContainer",

        Size = UDim2.new(1, 0, 1, 0),

        BackgroundTransparency = 1,

        Parent = Sidebar,
    }, {
        Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 4),
        }),

        Create("UIPadding", {
            PaddingTop = UDim.new(0, 2),
            PaddingBottom = UDim.new(0, 2),
        }),
    })

    self.TabContainer = TabContainer

    ----------------------------------------------------------------
    -- Content
    ----------------------------------------------------------------

    local ContentArea = Create("ScrollingFrame", {
        Name = "ContentArea",

        Size = UDim2.new(1, -150, 1, -54),
        Position = UDim2.new(0, 145, 0, 49),

        BackgroundTransparency = 1,
        BorderSizePixel = 0,

        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,

        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,

        ScrollingDirection = Enum.ScrollingDirection.Y,

        Parent = MainFrame,
    }, {
        Create("UIPadding", {
            PaddingTop = UDim.new(0, 2),
            PaddingBottom = UDim.new(0, 8),
            PaddingLeft = UDim.new(0, 2),
            PaddingRight = UDim.new(7, 0),
        }),

        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 9),
        }),
    })

    self.ContentArea = ContentArea

    ----------------------------------------------------------------
    -- Minimized button
    ----------------------------------------------------------------

    local MinimizedButton = Create("TextButton", {
        Name = "MinimizedButton",

        Size = UDim2.new(0, 44, 0, 44),
        Position = UDim2.new(0, 18, 0.5, -22),

        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,

        Text = "M",
        TextColor3 = Theme.TextPrimary,

        TextSize = 20,
        Font = Theme.Font,

        AutoButtonColor = false,

        Visible = false,

        Parent = ScreenGui,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 5),
        }),

        Create("UIStroke", {
            Color = Theme.Stroke,
            Thickness = 1,
        }),
    })

    self.MinimizedButton = MinimizedButton

    ----------------------------------------------------------------
    -- Connection helper
    ----------------------------------------------------------------

    function self:_Connect(signal, callback)
        if self.Destroyed then
            return nil
        end

        local connection = signal:Connect(callback)

        table.insert(self.Connections, connection)

        return connection
    end

    ----------------------------------------------------------------
    -- Hover helper
    ----------------------------------------------------------------

    local function SetupHover(button, normalColor, hoverColor)
        self:_Connect(button.MouseEnter, function()
            Tween(button, FAST_TWEEN, {
                BackgroundColor3 = hoverColor,
            })
        end)

        self:_Connect(button.MouseLeave, function()
            Tween(button, FAST_TWEEN, {
                BackgroundColor3 = normalColor,
            })
        end)
    end

    SetupHover(
        CloseButton,
        Theme.ElementBG,
        Theme.ElementHover
    )

    SetupHover(
        MinimizedButton,
        Theme.Background,
        Theme.ElementBG
    )

    ----------------------------------------------------------------
    -- Toggle UI
    ----------------------------------------------------------------

    local opening = false

    local function ShowUI()
        if self.Destroyed or opening then
            return
        end

        opening = true
        self.Visible = true

        MainFrame.Visible = true
        MinimizedButton.Visible = false

        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.BackgroundTransparency = 1

        local tween = Tween(
            MainFrame,

            TweenInfo.new(
                0.38,
                Enum.EasingStyle.Back,
                Enum.EasingDirection.Out
            ),

            {
                Size = self.Size,
                BackgroundTransparency = 0,
            }
        )

        if tween then
            tween.Completed:Wait()
        end

        opening = false
    end

    local function HideUI()
        if self.Destroyed or opening then
            return
        end

        opening = true
        self.Visible = false

        Tween(
            MainFrame,

            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.In
            ),

            {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1,
            }
        )

        task.delay(0.26, function()
            if self.Destroyed then
                return
            end

            MainFrame.Visible = false

            MinimizedButton.Visible = true
            MinimizedButton.Size = UDim2.new(0, 0, 0, 0)

            Tween(
                MinimizedButton,

                TweenInfo.new(
                    0.3,
                    Enum.EasingStyle.Back,
                    Enum.EasingDirection.Out
                ),

                {
                    Size = UDim2.new(0, 44, 0, 44),
                }
            )

            opening = false
        end)
    end

    self.Show = ShowUI
    self.Hide = HideUI

    function self:SetVisible(state)
        state = state == true

        if state then
            ShowUI()
        else
            HideUI()
        end
    end

    function self:Toggle()
        if self.Visible then
            HideUI()
        else
            ShowUI()
        end
    end

    ----------------------------------------------------------------
    -- Close / Minimize
    ----------------------------------------------------------------

    self:_Connect(CloseButton.MouseButton1Click, function()
        HideUI()
    end)

    self:_Connect(MinimizedButton.MouseButton1Click, function()
        ShowUI()
    end)

    ----------------------------------------------------------------
    -- Main dragging
    ----------------------------------------------------------------

    local dragging = false
    local dragStart
    local startPosition

    self:_Connect(Topbar.InputBegan, function(input, gameProcessed)
        if gameProcessed or self.Destroyed then
            return
        end

        if IsInput(input) then
            dragging = true
            dragStart = input.Position
            startPosition = MainFrame.Position
        end
    end)

    self:_Connect(Topbar.InputEnded, function(input)
        if IsInput(input) then
            dragging = false
        end
    end)

    self:_Connect(UserInputService.InputChanged, function(input)
        if not dragging or not IsMoveInput(input) then
            return
        end

        local delta = input.Position - dragStart

        MainFrame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,

            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)

    ----------------------------------------------------------------
    -- Minimized dragging
    ----------------------------------------------------------------

    local miniDragging = false
    local miniDragStart
    local miniStartPosition

    self:_Connect(MinimizedButton.InputBegan, function(input, gameProcessed)
        if gameProcessed or self.Destroyed then
            return
        end

        if IsInput(input) then
            miniDragging = true
            miniDragStart = input.Position
            miniStartPosition = MinimizedButton.Position
        end
    end)

    self:_Connect(MinimizedButton.InputEnded, function(input)
        if IsInput(input) then
            miniDragging = false
        end
    end)

    self:_Connect(UserInputService.InputChanged, function(input)
        if not miniDragging or not IsMoveInput(input) then
            return
        end

        local delta = input.Position - miniDragStart

        MinimizedButton.Position = UDim2.new(
            miniStartPosition.X.Scale,
            miniStartPosition.X.Offset + delta.X,

            miniStartPosition.Y.Scale,
            miniStartPosition.Y.Offset + delta.Y
        )
    end)

    ----------------------------------------------------------------
    -- Toggle key
    ----------------------------------------------------------------

    self:_Connect(UserInputService.InputBegan, function(input, gameProcessed)
        if gameProcessed or self.Destroyed then
            return
        end

        if input.KeyCode == self.ToggleKey then
            self:Toggle()
        end
    end)

    ----------------------------------------------------------------
    -- Responsive layout
    ----------------------------------------------------------------

    local function UpdateResponsiveLayout()
        if self.Destroyed then
            return
        end

        local camera = workspace.CurrentCamera

        if not camera then
            return
        end

        local viewport = camera.ViewportSize

        if viewport.X <= 600 then
            Sidebar.Size = UDim2.new(0, 100, 1, -44)

            ContentArea.Size = UDim2.new(1, -108, 1, -54)
            ContentArea.Position = UDim2.new(0, 103, 0, 49)

            MinimizedButton.Size = UDim2.new(0, 40, 0, 40)

            Title.TextSize = 16
        else
            Sidebar.Size = UDim2.new(0, 140, 1, -44)

            ContentArea.Size = UDim2.new(1, -150, 1, -54)
            ContentArea.Position = UDim2.new(0, 145, 0, 49)

            MinimizedButton.Size = UDim2.new(0, 44, 0, 44)

            Title.TextSize = 18
        end
    end

    self:_Connect(
        workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"),
        UpdateResponsiveLayout
    )

    UpdateResponsiveLayout()

    ----------------------------------------------------------------
    -- Default methods
    ----------------------------------------------------------------

    function self:SetTheme(newTheme)
        if typeof(newTheme) ~= "table" then
            return
        end

        for key, value in pairs(newTheme) do
            if Theme[key] ~= nil then
                Theme[key] = value
            end
        end
    end

    function self:GetTheme()
        local copy = {}

        for key, value in pairs(Theme) do
            copy[key] = value
        end

        return copy
    end

    ----------------------------------------------------------------
    -- Destroy
    ----------------------------------------------------------------

    function self:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        for _, connection in ipairs(self.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        table.clear(self.Connections)

        if self.ScreenGui then
            self.ScreenGui:Destroy()
        end

        table.clear(self.Tabs)
        table.clear(self.Components)
    end

    return self
end

