--============================================================
-- Label
--============================================================

function Library:CreateLabel(config)
    config = config or {}

    local label = {}

    setmetatable(label, {
        __index = self,
    })

    local Label = Create("TextLabel", {
        Name = config.Name or "Label",

        Size = UDim2.new(1, 0, 0, config.Height or 24),

        BackgroundTransparency = 1,

        Text = tostring(config.Text or ""),
        TextColor3 = config.Color or Theme.TextSecondary,

        TextSize = config.TextSize or 12,
        Font = config.Font or Theme.Font,

        TextWrapped = true,
        TextXAlignment = config.TextXAlignment or Enum.TextXAlignment.Left,

        LayoutOrder = config.LayoutOrder or 1,

        Parent = self.Frame,
    })

    label.Object = Label

    function label:SetText(text)
        Label.Text = tostring(text or "")
    end

    function label:SetColor(color)
        if typeof(color) == "Color3" then
            Tween(Label, DEFAULT_TWEEN, {
                TextColor3 = color,
            })
        end
    end

    return label
end

--============================================================
-- Button
--============================================================

function Library:CreateButton(config)
    config = config or {}

    local callback = config.Callback or function() end

    local button = {}

    setmetatable(button, {
        __index = self,
    })

    local Button = Create("TextButton", {
        Name = config.Name or "Button",

        Size = UDim2.new(1, 0, 0, config.Height or 32),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        Text = config.Name or "Button",
        TextColor3 = Theme.TextPrimary,

        TextSize = config.TextSize or 13,
        Font = Theme.Font,

        AutoButtonColor = false,

        LayoutOrder = config.LayoutOrder or 1,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),
    })

    button.Object = Button

    self:_Connect(Button.MouseEnter, function()
        Tween(Button, FAST_TWEEN, {
            BackgroundColor3 = Theme.ElementHover,
        })
    end)

    self:_Connect(Button.MouseLeave, function()
        Tween(Button, FAST_TWEEN, {
            BackgroundColor3 = Theme.ElementBG,
        })
    end)

    self:_Connect(Button.MouseButton1Click, function()
        SafeCallback(callback)
    end)

    function button:SetText(text)
        Button.Text = tostring(text or "")
    end

    function button:SetEnabled(enabled)
        enabled = enabled ~= false

        Button.Active = enabled
        Button.Selectable = enabled

        Tween(Button, DEFAULT_TWEEN, {
            TextColor3 = enabled
                and Theme.TextPrimary
                or Theme.TextDisabled,

            BackgroundColor3 = enabled
                and Theme.ElementBG
                or Theme.Background,
        })
    end

    return button
end

