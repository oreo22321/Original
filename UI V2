-- Tab
--============================================================

function Library:CreateTab(name)
    name = tostring(name or "TAB")

    local tab = {
        Name = name,
        Sections = {},
        LayoutOrder = #self.Tabs + 1,
    }

    setmetatable(tab, {
        __index = Library,
    })

    ----------------------------------------------------------------
    -- Tab button
    ----------------------------------------------------------------

    local TabButton = Create("TextButton", {
        Name = name .. "_Button",

        Size = UDim2.new(1, 0, 0, 35),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        Text = name:upper(),
        TextColor3 = Theme.TextSecondary,

        TextSize = 12,
        Font = Theme.Font,

        AutoButtonColor = false,

        LayoutOrder = tab.LayoutOrder,

        Parent = self.TabContainer,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),
    })

    ----------------------------------------------------------------
    -- Indicator
    ----------------------------------------------------------------

    local Indicator = Create("Frame", {
        Name = "Indicator",

        Size = UDim2.new(0, 2, 0.55, 0),
        Position = UDim2.new(0, 0, 0.225, 0),

        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,

        BackgroundTransparency = 1,

        Parent = TabButton,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    ----------------------------------------------------------------
    -- Content
    ----------------------------------------------------------------

    local TabContent = Create("Frame", {
        Name = name .. "_Content",

        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,

        BackgroundTransparency = 1,
        Visible = false,

        LayoutOrder = tab.LayoutOrder,

        Parent = self.ContentArea,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 9),
        }),
    })

    tab.Button = TabButton
    tab.Content = TabContent
    tab.Indicator = Indicator

    table.insert(self.Tabs, tab)

    ----------------------------------------------------------------
    -- Activate
    ----------------------------------------------------------------

    function tab:Select()
        for _, otherTab in ipairs(self.Tabs) do
            local active = otherTab == tab

            otherTab.Content.Visible = active

            Tween(
                otherTab.Button,
                DEFAULT_TWEEN,
                {
                    BackgroundColor3 = active
                        and Theme.Accent
                        or Theme.ElementBG,

                    TextColor3 = active
                        and Theme.Background
                        or Theme.TextSecondary,
                }
            )

            Tween(
                otherTab.Indicator,
                DEFAULT_TWEEN,
                {
                    BackgroundTransparency = active
                        and 0
                        or 1,
                }
            )
        end

        self.ActiveTab = tab
    end

    self:_Connect(TabButton.MouseEnter, function()
        if self.ActiveTab ~= tab then
            Tween(
                TabButton,
                FAST_TWEEN,
                {
                    BackgroundColor3 = Theme.ElementHover,
                }
            )
        end
    end)

    self:_Connect(TabButton.MouseLeave, function()
        if self.ActiveTab ~= tab then
            Tween(
                TabButton,
                FAST_TWEEN,
                {
                    BackgroundColor3 = Theme.ElementBG,
                }
            )
        end
    end)

    self:_Connect(TabButton.MouseButton1Click, function()
        tab:Select()
    end)

    if #self.Tabs == 1 then
        tab:Select()
    end

    return tab
end

