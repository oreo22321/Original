-- OrionLibのロード（ご提示いただいたURLを使用）
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/jadpy/suki/refs/heads/main/orion"))()

-- プレイヤーとサービスの参照
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- GUIのウィンドウを作成
local Window = OrionLib:CreateWindow({
    Name = "My Orion Script by Gemini", -- ウィンドウのタイトル
    HidePremium = true, -- 有料機能を非表示
    SaveConfig = true, -- 設定を保存
    Keybind = Enum.KeyCode.RightControl -- 表示/非表示のキーバインド（スマホでは無視される可能性が高い）
})

-- 新しいタブを作成: 'Player' タブ
local Tab = Window:AddTab({
    Name = "Player",
    Icon = "rbxassetid://4483362446", -- 適当なRobloxアイコンID
    PremiumOnly = false
})

-- Sectionを作成: 'Movement' セクション
Tab:AddSection({
    Name = "Movement"
})

-- スライダーを作成: WalkSpeedの変更
Tab:AddSlider({
    Name = "WalkSpeed Changer",
    Min = 16, -- 最小値16
    Max = 100, -- 最大値100
    Default = 16,
    Color = Color3.fromRGB(255, 100, 100), -- スライダーの色
    Type = "Normal",
    Callback = function(value)
        -- スライダーの値が変更されたときに実行される
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = value
        end
    end
})

-- トグルボタンを作成: No-Clip
Tab:AddToggle({
    Name = "No-Clip",
    Default = false,
    Callback = function(isToggled)
        -- トグルの状態が変更されたときに実行される
        local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                -- トグルがONなら衝突判定を無効に
                part.CanCollide = not isToggled
            end
        end
    end
})

-- ボタンを作成: テレポート
Tab:AddButton({
    Name = "Teleport to Spawn",
    Callback = function()
        -- ボタンが押されたときに実行される
        local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local Spawn = game.Workspace:FindFirstChild("SpawnLocation") or game.Workspace:FindFirstChildOfClass("SpawnLocation")
        
        if Spawn and Character.PrimaryPart then
            -- スポーン地点に少し浮かせた位置へテレポート
            Character:SetPrimaryPartCFrame(Spawn.CFrame * CFrame.new(0, 5, 0))
        end
    end
})

-- 通知でロード完了を知らせる
OrionLib:MakeNotification({
    Name = "Orion Loaded",
    Content = "The custom UI is ready to use.",
    Time = 5 -- 表示時間（秒）
})
