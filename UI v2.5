-- ============================================================
-- Label
-- ============================================================

function Library:CreateLabel(config)
    config = config or {}

    local Label = Create("TextLabel", {
        Size = UDim2.new(
            1,
            0,
            0,
            config.Height or 24
        ),

        BackgroundTransparency = 1,

        Text = tostring(config.Text or ""),
        TextColor3 = config.Color or Theme.TextSecondary,

        TextSize = config.TextSize or 12,
        Font = config.Font or Theme.Font,

        TextWrapped = true,

        TextXAlignment = config.TextXAlignment
            or Enum.TextXAlignment.Left,

        Parent = self.Frame,
    })

    return {
        Object = Label,

        SetText = function(text)
            Label.Text = tostring(text or "")
        end,

        SetColor = function(color)
            if typeof(color) == "Color3" then
                Label.TextColor3 = color
            end
        end,
    }
end

-- ============================================================
-- Button
-- ============================================================

function Library:CreateButton(config)
    config = config or {}

    local callback = config.Callback

    local Button = Create("TextButton", {
        Name = config.Name or "Button",

        Size = UDim2.new(
            1,
            0,
            0,
            config.Height or 32
        ),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        Text = config.Name or "Button",
        TextColor3 = Theme.TextPrimary,

        TextSize = config.TextSize or 13,
        Font = Theme.Font,

        AutoButtonColor = false,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),
    })

    self:Connect(
        Button.MouseEnter,
        function()
            Tween(Button, nil, {
                BackgroundColor3 = Theme.ElementHover,
            })
        end
    )

    self:Connect(
        Button.MouseLeave,
        function()
            Tween(Button, nil, {
                BackgroundColor3 = Theme.ElementBG,
            })
        end
    )

    self:Connect(
        Button.MouseButton1Click,
        function()
            SafeCallback(callback)
        end
    )

    return {
        Object = Button,

        SetText = function(text)
            Button.Text = tostring(text or "")
        end,

        SetEnabled = function(enabled)
            enabled = enabled ~= false

            Button.Active = enabled
            Button.Selectable = enabled

            Button.TextColor3 = enabled
                and Theme.TextPrimary
                or Theme.TextDisabled
        end,
    }
end

-- ============================================================
-- Toggle
-- ============================================================

function Library:CreateToggle(config)
    config = config or {}

    local callback = config.Callback
    local state = config.Default == true

    local ToggleFrame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 32),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),

        Create("TextLabel", {
            Size = UDim2.new(1, -60, 1, 0),
            Position = UDim2.new(0, 12, 0, 0),

            BackgroundTransparency = 1,

            Text = config.Name or "Toggle",
            TextColor3 = Theme.TextPrimary,

            TextSize = 13,
            Font = Theme.Font,

            TextXAlignment = Enum.TextXAlignment.Left,
        }),
    })

    local SwitchBG = Create("Frame", {
        Size = UDim2.new(0, 36, 0, 18),
        Position = UDim2.new(1, -46, 0.5, -9),

        BackgroundColor3 = Theme.Track,
        BorderSizePixel = 0,

        Parent = ToggleFrame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    local SwitchKnob = Create("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(0, 2, 0.5, -7),

        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,

        Parent = SwitchBG,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    local ClickArea = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),

        BackgroundTransparency = 1,

        Text = "",

        AutoButtonColor = false,

        Parent = ToggleFrame,
    })

    local function UpdateState(newState, fireCallback)
        state = newState == true

        if state then
            Tween(
                SwitchBG,
                nil,
                {
                    BackgroundColor3 = Theme.Accent,
                }
            )

            Tween(
                SwitchKnob,
                TweenInfo.new(
                    0.25,
                    Enum.EasingStyle.Back,
                    Enum.EasingDirection.Out
                ),
                {
                    Position = UDim2.new(
                        1,
                        -16,
                        0.5,
                        -7
                    ),

                    BackgroundColor3 = Theme.Background,
                }
            )
        else
            Tween(
                SwitchBG,
                nil,
                {
                    BackgroundColor3 = Theme.Track,
                }
            )

            Tween(
                SwitchKnob,
                TweenInfo.new(
                    0.25,
                    Enum.EasingStyle.Back,
                    Enum.EasingDirection.Out
                ),
                {
                    Position = UDim2.new(
                        0,
                        2,
                        0.5,
                        -7
                    ),

                    BackgroundColor3 = Theme.Accent,
                }
            )
        end

        if fireCallback ~= false then
            SafeCallback(callback, state)
        end
    end

    self:Connect(
        ClickArea.MouseEnter,
        function()
            Tween(ToggleFrame, nil, {
                BackgroundColor3 = Theme.ElementHover,
            })
        end
    )

    self:Connect(
        ClickArea.MouseLeave,
        function()
            Tween(ToggleFrame, nil, {
                BackgroundColor3 = Theme.ElementBG,
            })
        end
    )

    self:Connect(
        ClickArea.MouseButton1Click,
        function()
            UpdateState(not state, true)
        end
    )

    UpdateState(state, false)

    return {
        Object = ToggleFrame,

        SetState = function(value)
            UpdateState(value, true)
        end,

        GetState = function()
            return state
        end,

        Toggle = function()
            UpdateState(not state, true)
        end,
    }
end

-- ============================================================
-- Slider
-- ============================================================

function Library:CreateSlider(config)
    config = config or {}

    local min = tonumber(config.Min) or 0
    local max = tonumber(config.Max) or 100
    local step = tonumber(config.Step) or 1

    if max < min then
        min, max = max, min
    end

    if step <= 0 then
        step = 1
    end

    local default = tonumber(config.Default)

    if default == nil then
        default = min
    end

    default = math.clamp(
        default,
        min,
        max
    )

    local value = default
    local callback = config.Callback

    local SliderFrame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),

        Create("TextLabel", {
            Size = UDim2.new(1, -70, 0, 16),
            Position = UDim2.new(0, 12, 0, 4),

            BackgroundTransparency = 1,

            Text = config.Name or "Slider",
            TextColor3 = Theme.TextPrimary,

            TextSize = 13,
            Font = Theme.Font,

            TextXAlignment = Enum.TextXAlignment.Left,
        }),
    })

    local ValueLabel = Create("TextLabel", {
        Size = UDim2.new(0, 60, 0, 16),
        Position = UDim2.new(1, -68, 0, 4),

        BackgroundTransparency = 1,

        Text = FormatNumber(value),
        TextColor3 = Theme.TextSecondary,

        TextSize = 12,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Right,

        Parent = SliderFrame,
    })

    local TrackBG = Create("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 1, -14),

        BackgroundColor3 = Theme.Track,
        BorderSizePixel = 0,

        Parent = SliderFrame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    local Fill = Create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),

        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,

        Parent = TrackBG,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    local Knob = Create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),

        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,

        Parent = TrackBG,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    -- ========================================================
    -- Fixed: safe ratio
    -- ========================================================

    local function GetRatio(number)
        local range = max - min

        if range <= 0 then
            return 0
        end

        return math.clamp(
            (number - min) / range,
            0,
            1
        )
    end

    local function SnapValue(number)
        local snapped = min
            + math.round(
                (number - min) / step
            ) * step

        return math.clamp(
            snapped,
            min,
            max
        )
    end

    local function SetValue(newValue, fireCallback)
        newValue = tonumber(newValue)

        if not newValue then
            return
        end

        value = SnapValue(newValue)

        local ratio = GetRatio(value)

        Fill.Size = UDim2.new(
            ratio,
            0,
            1,
            0
        )

        Knob.Position = UDim2.new(
            ratio,
            -6,
            0.5,
            -6
        )

        ValueLabel.Text = FormatNumber(value)

        if fireCallback ~= false then
            SafeCallback(
                callback,
                value
            )
        end
    end

    local draggingSlider = false

    local function UpdateFromInput(input)
        if TrackBG.AbsoluteSize.X <= 0 then
            return
        end

        local ratio =
            (
                input.Position.X
                - TrackBG.AbsolutePosition.X
            )
            / TrackBG.AbsoluteSize.X

        ratio = math.clamp(
            ratio,
            0,
            1
        )

        local newValue =
            min
            + (max - min) * ratio

        SetValue(
            newValue,
            true
        )
    end

    self:Connect(
        TrackBG.InputBegan,
        function(input, gameProcessed)
            if gameProcessed then
                return
            end

            if IsClickInput(input) then
                draggingSlider = true

                UpdateFromInput(input)
            end
        end
    )

    self:Connect(
        TrackBG.InputEnded,
        function(input)
            if IsClickInput(input) then
                draggingSlider = false
            end
        end
    )

    self:Connect(
        UserInputService.InputEnded,
        function(input)
            if IsClickInput(input) then
                draggingSlider = false
            end
        end
    )

    self:Connect(
        UserInputService.InputChanged,
        function(input)
            if draggingSlider
                and IsMovementInput(input) then

                UpdateFromInput(input)
            end
        end
    )

    SetValue(
        default,
        false
    )

    return {
        Object = SliderFrame,

        SetValue = function(newValue)
            SetValue(newValue, true)
        end,

        GetValue = function()
            return value
        end,
    }
end

-- ============================================================
-- Dropdown
-- ============================================================

function Library:CreateDropdown(config)
    config = config or {}

    local options = config.Options or {}
    local callback = config.Callback

    local selectedValue =
        config.Default

        or options[1]

    local isOpen = false

    local itemHeight = 28
    local padding = 4

    local totalListHeight =
        (#options * itemHeight)
        + (math.max(0, #options - 1) * 2)
        + (padding * 2)

    local DropdownFrame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 32),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        ClipsDescendants = true,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),
    })

    local Header = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),

        BackgroundTransparency = 1,

        Text = "",

        AutoButtonColor = false,

        Parent = DropdownFrame,
    })

    local Label = Create("TextLabel", {
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),

        BackgroundTransparency = 1,

        Text = tostring(
            selectedValue
            or "Select..."
        ),

        TextColor3 = Theme.TextPrimary,

        TextSize = 13,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = Header,
    })

    local Arrow = Create("TextLabel", {
        Size = UDim2.new(0, 20, 0, 32),
        Position = UDim2.new(1, -30, 0, 0),

        BackgroundTransparency = 1,

        Text = "▼",
        TextColor3 = Theme.TextSecondary,

        TextSize = 12,
        Font = Theme.Font,

        Parent = Header,
    })

    local ListContainer = Create("Frame", {
        Name = "List",

        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 32),

        BackgroundColor3 = Color3.fromRGB(
            15,
            15,
            15
        ),

        BorderSizePixel = 0,

        Parent = DropdownFrame,
    }, {
        Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,

            Padding = UDim.new(0, 2),
        }),

        Create("UIPadding", {
            PaddingTop = UDim.new(0, padding),
            PaddingBottom = UDim.new(0, padding),
            PaddingLeft = UDim.new(0, padding),
            PaddingRight = UDim.new(0, padding),
        }),
    })

    -- ========================================================
    -- IMPORTANT FIX
    --
    -- The variable must be declared BEFORE option callbacks.
    -- ========================================================

    local ToggleDropdown

    -- ========================================================
    -- Options
    -- ========================================================

    for index, option in ipairs(options) do
        local ItemButton = Create("TextButton", {
            Name = "Option_" .. index,

            Size = UDim2.new(
                1,
                0,
                0,
                itemHeight
            ),

            BackgroundColor3 = Color3.fromRGB(
                15,
                15,
                15
            ),

            BorderSizePixel = 0,

            Text = tostring(option),
            TextColor3 = Theme.TextPrimary,

            TextSize = 12,
            Font = Theme.Font,

            AutoButtonColor = false,

            Parent = ListContainer,
        }, {
            Create("UICorner", {
                CornerRadius = UDim.new(0, 2),
            }),
        })

        self:Connect(
            ItemButton.MouseEnter,
            function()
                Tween(
                    ItemButton,
                    nil,
                    {
                        BackgroundColor3 =
                            Theme.ElementHover,
                    }
                )
            end
        )

        self:Connect(
            ItemButton.MouseLeave,
            function()
                Tween(
                    ItemButton,
                    nil,
                    {
                        BackgroundColor3 =
                            Color3.fromRGB(
                                15,
                                15,
                                15
                            ),
                    }
                )
            end
        )

        self:Connect(
            ItemButton.MouseButton1Click,
            function()
                selectedValue = option

                Label.Text =
                    tostring(option)

                SafeCallback(
                    callback,
                    option
                )

                -- FIXED:
                -- ToggleDropdown is now a declared local
                -- assigned before this callback can execute.
                ToggleDropdown(false)
            end
        )
    end

    -- ========================================================
    -- Dropdown Toggle
    -- ========================================================

    ToggleDropdown = function(state)
        if state == nil then
            state = not isOpen
        end

        isOpen = state == true

        local targetListSize
        local targetFrameSize

        if isOpen then
            targetListSize = UDim2.new(
                1,
                0,
                0,
                totalListHeight
            )

            targetFrameSize = UDim2.new(
                1,
                0,
                0,
                32 + totalListHeight
            )
        else
            targetListSize = UDim2.new(
                1,
                0,
                0,
                0
            )

            targetFrameSize = UDim2.new(
                1,
                0,
                0,
                32
            )
        end

        Tween(
            ListContainer,

            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),

            {
                Size = targetListSize,
            }
        )

        Tween(
            DropdownFrame,

            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),

            {
                Size = targetFrameSize,
            }
        )

        Tween(
            Arrow,

            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),

            {
                Rotation = isOpen
                    and 180
                    or 0,
            }
        )
    end

    -- ========================================================
    -- Header
    -- ========================================================

    self:Connect(
        Header.MouseEnter,
        function()
            Tween(
                DropdownFrame,
                nil,
                {
                    BackgroundColor3 =
                        Theme.ElementHover,
                }
            )
        end
    )

    self:Connect(
        Header.MouseLeave,
        function()
            Tween(
                DropdownFrame,
                nil,
                {
                    BackgroundColor3 =
                        Theme.ElementBG,
                }
            )
        end
    )

    self:Connect(
        Header.MouseButton1Click,
        function()
            ToggleDropdown()
        end
    )

    return {
        Object = DropdownFrame,

        SetValue = function(value)
            for _, option in ipairs(options) do
                if option == value then
                    selectedValue = value
                    Label.Text = tostring(value)

                    return true
                end
            end

            return false
        end,

        SetText = function(text)
            Label.Text = tostring(text or "")
        end,

        GetSelected = function()
            return selectedValue
        end,

        Open = function()
            ToggleDropdown(true)
        end,

        Close = function()
            ToggleDropdown(false)
        end,

        IsOpen = function()
            return isOpen
        end,
    }
end

-- ============================================================
-- Notification
-- ============================================================

function Library:Notify(config)
    config = config or {}

    local title =
        tostring(config.Title or "NOTICE")

    local text =
        tostring(config.Text or "")

    local duration =
        tonumber(config.Duration) or 3

    local Notification = Create("Frame", {
        Name = "Notification",

        Size = UDim2.new(0, 280, 0, 70),

        Position = UDim2.new(
            1,
            300,
            1,
            -20
        ),

        AnchorPoint = Vector2.new(1, 1),

        BackgroundColor3 = Theme.Topbar,
        BorderSizePixel = 0,

        Parent = self.ScreenGui,
    }, {
        Create("UICorner", {
            CornerRadius = Theme.CornerRadius,
        }),

        Create("UIStroke", {
            Color = Theme.Stroke,
            Thickness = 1,
        }),
    })

    Create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),

        BackgroundTransparency = 1,

        Text = title,
        TextColor3 = Theme.TextPrimary,

        TextSize = 13,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = Notification,
    })

    Create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 30),
        Position = UDim2.new(0, 12, 0, 30),

        BackgroundTransparency = 1,

        Text = text,
        TextColor3 = Theme.TextSecondary,

        TextSize = 11,
        Font = Theme.Font,

        TextWrapped = true,

        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,

        Parent = Notification,
    })

    Tween(
        Notification,

        TweenInfo.new(
            0.3,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),

        {
            Position = UDim2.new(
                1,
                -20,
                1,
                -20
            ),
        }
    )

    task.delay(
        duration,
        function()
            if not Notification.Parent then
                return
            end

            local tween = Tween(
                Notification,

                TweenInfo.new(
                    0.25,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.In
                ),

                {
                    Position = UDim2.new(
                        1,
                        300,
                        1,
                        -20
                    ),
                }
            )

            if tween then
                tween.Completed:Wait()
            end

            if Notification then
                Notification:Destroy()
            end
        end
    )

    return Notification
end

-- ============================================================
-- Global Theme
-- ============================================================

function Library:SetTheme(newTheme)
    if typeof(newTheme) ~= "table" then
        return
    end

    for key, value in pairs(newTheme) do
        if Theme[key] ~= nil then
            Theme[key] = value
        end
    end
end

function Library:GetTheme()
    local copy = {}

    for key, value in pairs(Theme) do
        copy[key] = value
    end

    return copy
end

-- ============================================================
-- Return
-- ============================================================

return Library
