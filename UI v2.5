        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,

        Parent = self.Content,
    }, {
        Create("UICorner", {
            CornerRadius = Theme.CornerRadius,
        }),

        Create("UIStroke", {
            Color = Theme.Stroke,
            Thickness = 1,
        }),

        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
