-- ============================================================
-- MonochromeUI
-- Fixed / Improved Edition
-- ============================================================

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- Theme
-- ============================================================

local Theme = {
    Background = Color3.fromRGB(5, 5, 5),
    Topbar = Color3.fromRGB(12, 12, 12),
    Sidebar = Color3.fromRGB(10, 10, 10),
    ElementBG = Color3.fromRGB(18, 18, 18),
    ElementHover = Color3.fromRGB(28, 28, 28),
    Track = Color3.fromRGB(30, 30, 30),
    Stroke = Color3.fromRGB(40, 40, 40),

    Accent = Color3.fromRGB(255, 255, 255),

    TextPrimary = Color3.fromRGB(240, 240, 240),
    TextSecondary = Color3.fromRGB(100, 100, 100),
    TextDisabled = Color3.fromRGB(65, 65, 65),

    Font = Enum.Font.Garamond,

    CornerRadius = UDim.new(0, 3),
}

-- ============================================================
-- Utility
-- ============================================================

local function Create(className, properties, children)
    local instance = Instance.new(className)

    for key, value in pairs(properties or {}) do
        if key ~= "Parent" then
            instance[key] = value
        end
    end

    for _, child in ipairs(children or {}) do
        child.Parent = instance
    end

    if properties and properties.Parent then
        instance.Parent = properties.Parent
    end

    return instance
end

local function Tween(instance, tweenInfo, properties)
    if not instance or not instance.Parent then
        return
    end

    local tween = TweenService:Create(
        instance,
        tweenInfo or TweenInfo.new(
            0.2,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        properties
    )

    tween:Play()

    return tween
end

local function SafeCallback(callback, ...)
    if typeof(callback) ~= "function" then
        return
    end

    local success, errorMessage = pcall(
        callback,
        ...
    )

    if not success then
        warn("[MonochromeUI] Callback error:", errorMessage)
    end
end

local function IsClickInput(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function IsMovementInput(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

local function FormatNumber(value)
    if math.abs(value - math.round(value)) < 0.000001 then
        return tostring(math.round(value))
    end

    return string.format("%.2f", value)
        :gsub("0+$", "")
        :gsub("%.$", "")
end

-- ============================================================
-- Library
-- ============================================================

local Library = {}
Library.__index = Library

-- ============================================================
-- Window
-- ============================================================

function Library:CreateWindow(config)
    config = config or {}

    local self = setmetatable({}, Library)

    self.Tabs = {}
    self.Connections = {}
    self.Destroyed = false
    self.Visible = true

    self.Name = config.Name or "SYSTEM"
    self.ToggleKey = config.ToggleKey or Enum.KeyCode.RightShift

    self.Size = config.Size or UDim2.new(
        0.95,
        0,
        0.8,
        0
    )

    -- Remove previous instance
    pcall(function()
        local old = CoreGui:FindFirstChild("MonochromeUI")

        if old then
            old:Destroy()
        end
    end)

    -- ========================================================
    -- ScreenGui
    -- ========================================================

    local ScreenGui = Create("ScreenGui", {
        Name = "MonochromeUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = false,
        Parent = CoreGui,
    })

    self.ScreenGui = ScreenGui

    -- ========================================================
    -- MainFrame
    -- ========================================================

    local MainFrame = Create("Frame", {
        Name = "MainFrame",

        Size = self.Size,
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),

        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,

        Parent = ScreenGui,
    }, {
        Create("UICorner", {
            CornerRadius = Theme.CornerRadius,
        }),

        Create("UIStroke", {
            Color = Theme.Stroke,
            Thickness = 1,
        }),

        Create("UISizeConstraint", {
            MinSize = Vector2.new(320, 240),
            MaxSize = Vector2.new(1100, 750),
        }),
    })

    self.MainFrame = MainFrame

    -- ========================================================
    -- Topbar
    -- ========================================================

    local Topbar = Create("Frame", {
        Name = "Topbar",

        Size = UDim2.new(1, 0, 0, 45),

        BackgroundColor3 = Theme.Topbar,
        BorderSizePixel = 0,

        Parent = MainFrame,
    }, {
        Create("UICorner", {
            CornerRadius = Theme.CornerRadius,
        }),

        Create("UIStroke", {
            Color = Theme.Stroke,
            Thickness = 0.5,
            Transparency = 0.5,
        }),
    })

    local Title = Create("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.new(0, 15, 0, 0),

        BackgroundTransparency = 1,

        Text = self.Name,
        TextColor3 = Theme.TextPrimary,

        TextSize = 18,
        Font = Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = Topbar,
    })

    -- ========================================================
    -- Close
    -- ========================================================

    local CloseButton = Create("TextButton", {
        Name = "CloseButton",

        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -40, 0.5, -15),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        Text = "×",
        TextColor3 = Theme.TextPrimary,

        TextSize = 20,
        Font = Theme.Font,

        AutoButtonColor = false,

        Parent = Topbar,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 3),
        }),
    })

    -- ========================================================
    -- Sidebar
    -- ========================================================

    local Sidebar = Create("Frame", {
        Name = "Sidebar",

        Size = UDim2.new(0, 140, 1, -45),
        Position = UDim2.new(0, 0, 0, 45),

        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0,

        Parent = MainFrame,
    })

    self.Sidebar = Sidebar

    local TabContainer = Create("Frame", {
        Name = "TabContainer",

        Size = UDim2.new(1, 0, 1, 0),

        BackgroundTransparency = 1,

        Parent = Sidebar,
    }, {
        Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            SortOrder = Enum.SortOrder.LayoutOrder,

            Padding = UDim.new(0, 4),
        }),

        Create("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 10),
            PaddingRight = UDim.new(0, 10),
        }),
    })

    self.TabContainer = TabContainer

    -- ========================================================
    -- Content
    -- ========================================================

    local ContentArea = Create("ScrollingFrame", {
        Name = "ContentArea",

        Size = UDim2.new(1, -150, 1, -55),
        Position = UDim2.new(0, 145, 0, 50),

        BackgroundTransparency = 1,
        BorderSizePixel = 0,

        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,

        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,

        Parent = MainFrame,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 10),
        }),

        Create("UIPadding", {
            PaddingTop = UDim.new(0, 5),
            PaddingBottom = UDim.new(0, 8),
            PaddingLeft = UDim.new(0, 2),
            PaddingRight = UDim.new(0, 5),
        }),
    })

    self.ContentArea = ContentArea

    -- ========================================================
    -- Minimized Button
    -- ========================================================

    local MinimizedButton = Create("TextButton", {
        Name = "MinimizedButton",

        Size = UDim2.new(0, 40, 0, 40),
        Position = UDim2.new(0, 20, 0.5, -20),

        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,

        Text = "M",
        TextColor3 = Theme.TextPrimary,

        TextSize = 20,
        Font = Theme.Font,

        AutoButtonColor = false,

        Visible = false,

        Parent = ScreenGui,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 4),
        }),

        Create("UIStroke", {
            Color = Theme.Stroke,
            Thickness = 1,
        }),
    })

    self.MinimizedButton = MinimizedButton

    -- ========================================================
    -- Connection Manager
    -- ========================================================

    function self:Connect(signal, callback)
        if self.Destroyed then
            return
        end

        local connection = signal:Connect(callback)

        table.insert(
            self.Connections,
            connection
        )

        return connection
    end

    -- ========================================================
    -- Hover
    -- ========================================================

    self:Connect(CloseButton.MouseEnter, function()
        Tween(CloseButton, nil, {
            BackgroundColor3 = Theme.ElementHover,
        })
    end)

    self:Connect(CloseButton.MouseLeave, function()
        Tween(CloseButton, nil, {
            BackgroundColor3 = Theme.ElementBG,
        })
    end)

    -- ========================================================
    -- Toggle UI
    -- ========================================================

    local animationRunning = false

    local function ShowUI()
        if self.Destroyed or animationRunning then
            return
        end

        animationRunning = true
        self.Visible = true

        MinimizedButton.Visible = false
        MainFrame.Visible = true

        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.BackgroundTransparency = 1

        local tween = Tween(
            MainFrame,

            TweenInfo.new(
                0.4,
                Enum.EasingStyle.Back,
                Enum.EasingDirection.Out
            ),

            {
                Size = self.Size,
                BackgroundTransparency = 0,
            }
        )

        if tween then
            tween.Completed:Wait()
        end

        animationRunning = false
    end

    local function HideUI()
        if self.Destroyed or animationRunning then
            return
        end

        animationRunning = true
        self.Visible = false

        Tween(
            MainFrame,

            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.In
            ),

            {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1,
            }
        )

        task.delay(0.27, function()
            if self.Destroyed then
                return
            end

            MainFrame.Visible = false

            MinimizedButton.Visible = true
            MinimizedButton.Size = UDim2.new(0, 0, 0, 0)

            Tween(
                MinimizedButton,

                TweenInfo.new(
                    0.3,
                    Enum.EasingStyle.Back,
                    Enum.EasingDirection.Out
                ),

                {
                    Size = UDim2.new(0, 40, 0, 40),
                }
            )

            animationRunning = false
        end)
    end

    function self:Toggle()
        if self.Visible then
            HideUI()
        else
            ShowUI()
        end
    end

    function self:SetVisible(state)
        if state then
            ShowUI()
        else
            HideUI()
        end
    end

    -- ========================================================
    -- Close / Minimize
    -- ========================================================

    self:Connect(
        CloseButton.MouseButton1Click,
        function()
            if self.Visible then
                HideUI()
            end
        end
    )

    self:Connect(
        MinimizedButton.MouseButton1Click,
        function()
            if not self.Visible then
                ShowUI()
            end
        end
    )

    -- ========================================================
    -- Main Drag
    -- ========================================================

    local dragging = false
    local dragStart
    local startPosition

    self:Connect(
        Topbar.InputBegan,
        function(input, gameProcessed)
            if gameProcessed then
                return
            end

            if IsClickInput(input) then
                dragging = true

                dragStart = input.Position
                startPosition = MainFrame.Position
            end
        end
    )

    self:Connect(
        Topbar.InputEnded,
        function(input)
            if IsClickInput(input) then
                dragging = false
            end
        end
    )

    self:Connect(
        UserInputService.InputChanged,
        function(input)
            if not dragging then
                return
            end

            if not IsMovementInput(input) then
                return
            end

            local delta = input.Position - dragStart

            MainFrame.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,

                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    )

    -- ========================================================
    -- Minimized Drag
    -- ========================================================

    local draggingMini = false
    local dragStartMini
    local startPositionMini

    self:Connect(
        MinimizedButton.InputBegan,
        function(input, gameProcessed)
            if gameProcessed then
                return
            end

            if IsClickInput(input) then
                draggingMini = true

                dragStartMini = input.Position
                startPositionMini = MinimizedButton.Position
            end
        end
    )

    self:Connect(
        MinimizedButton.InputEnded,
        function(input)
            if IsClickInput(input) then
                draggingMini = false
            end
        end
    )

    self:Connect(
        UserInputService.InputChanged,
        function(input)
            if not draggingMini then
                return
            end

            if not IsMovementInput(input) then
                return
            end

            local delta = input.Position - dragStartMini

            MinimizedButton.Position = UDim2.new(
                startPositionMini.X.Scale,
                startPositionMini.X.Offset + delta.X,

                startPositionMini.Y.Scale,
                startPositionMini.Y.Offset + delta.Y
            )
        end
    )

    -- ========================================================
    -- Toggle Key
    -- ========================================================

    self:Connect(
        UserInputService.InputBegan,
        function(input, gameProcessed)
            if gameProcessed then
                return
            end

            if input.KeyCode == self.ToggleKey then
                self:Toggle()
            end
        end
    )

    -- ========================================================
    -- Responsive Layout
    -- ========================================================

    local function UpdateResponsiveLayout()
        if self.Destroyed then
            return
        end

        local camera = workspace.CurrentCamera

        if not camera then
            return
        end

        local viewport = camera.ViewportSize

        if viewport.X <= 600 then
            Sidebar.Size = UDim2.new(
                0,
                100,
                1,
                -45
            )

            ContentArea.Size = UDim2.new(
                1,
                -110,
                1,
                -55
            )

            ContentArea.Position = UDim2.new(
                0,
                105,
                0,
                50
            )

            Title.TextSize = 16
        else
            Sidebar.Size = UDim2.new(
                0,
                140,
                1,
                -45
            )

            ContentArea.Size = UDim2.new(
                1,
                -150,
                1,
                -55
            )

            ContentArea.Position = UDim2.new(
                0,
                145,
                0,
                50
            )

            Title.TextSize = 18
        end
    end

    self:Connect(
        workspace.CurrentCamera:GetPropertyChangedSignal(
            "ViewportSize"
        ),
        UpdateResponsiveLayout
    )

    UpdateResponsiveLayout()

    -- ========================================================
    -- Theme API
    -- ========================================================

    function self:SetTheme(newTheme)
        if typeof(newTheme) ~= "table" then
            return
        end

        for key, value in pairs(newTheme) do
            if Theme[key] ~= nil then
                Theme[key] = value
            end
        end
    end

    function self:GetTheme()
        local copy = {}

        for key, value in pairs(Theme) do
            copy[key] = value
        end

        return copy
    end

    -- ========================================================
    -- Destroy
    -- ========================================================

    function self:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        for _, connection in ipairs(self.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        table.clear(self.Connections)
        table.clear(self.Tabs)

        if self.ScreenGui then
            self.ScreenGui:Destroy()
        end
    end

    return self
end

-- ============================================================
-- Tab
-- ============================================================

function Library:CreateTab(name)
    name = tostring(name or "TAB")

    local tab = {
        Name = name,
        Sections = {},
    }

    setmetatable(tab, {
        __index = self,
    })

    local TabButton = Create("TextButton", {
        Name = name .. "_Button",

        Size = UDim2.new(1, 0, 0, 36),

        BackgroundColor3 = Theme.ElementBG,
        BorderSizePixel = 0,

        Text = name:upper(),
        TextColor3 = Theme.TextSecondary,

        TextSize = 13,
        Font = Theme.Font,

        AutoButtonColor = false,

        Parent = self.TabContainer,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(0, 2),
        }),
    })

    local Indicator = Create("Frame", {
        Size = UDim2.new(0, 2, 0.55, 0),
        Position = UDim2.new(0, 0, 0.225, 0),

        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,

        BorderSizePixel = 0,

        Parent = TabButton,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    local TabContent = Create("Frame", {
        Name = name .. "_Content",

        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,

        BackgroundTransparency = 1,

        Visible = false,

        Parent = self.ContentArea,
    }, {
        Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
        }),
    })

    tab.Button = TabButton
    tab.Content = TabContent
    tab.Indicator = Indicator

    table.insert(
        self.Tabs,
        tab
    )

    function tab:Select()
        for _, otherTab in ipairs(self.Tabs) do
            local active = otherTab == tab

            otherTab.Content.Visible = active

            Tween(
                otherTab.Button,
                nil,
                {
                    BackgroundColor3 = active
                        and Theme.Accent
                        or Theme.ElementBG,

                    TextColor3 = active
                        and Theme.Background
                        or Theme.TextSecondary,
                }
            )

            Tween(
                otherTab.Indicator,
                nil,
                {
                    BackgroundTransparency = active
                        and 0
                        or 1,
                }
            )
        end
    end

    self:Connect(
        TabButton.MouseEnter,
        function()
            if TabContent.Visible then
                return
            end

            Tween(
                TabButton,
                nil,
                {
                    BackgroundColor3 = Theme.ElementHover,
                }
            )
        end
    )

    self:Connect(
        TabButton.MouseLeave,
        function()
            if TabContent.Visible then
                return
            end

            Tween(
                TabButton,
                nil,
                {
                    BackgroundColor3 = Theme.ElementBG,
                }
            )
        end
    )

    self:Connect(
        TabButton.MouseButton1Click,
        function()
            tab:Select()
        end
    )

    if #self.Tabs == 1 then
        tab:Select()
    end

    return tab
end

