                0,
                0
            ),

            AutomaticSize =
                Enum.AutomaticSize.Y,

            BackgroundColor3 =
                self.Window.Theme.Background,

            BorderSizePixel = 0,

            Parent =
                self.Content,

        }, {

            Create("UICorner", {
                CornerRadius =
                    self.Window.Theme.CornerRadius,
            }),

            Create("UIStroke", {
                Color =
                    self.Window.Theme.Stroke,

                Thickness = 1,
            }),

            Create("UIPadding", {
                PaddingTop =
                    UDim.new(
                        0,
                        11
                    ),

                PaddingBottom =
                    UDim.new(
                        0,
                        11
                    ),

                PaddingLeft =
                    UDim.new(
                        0,
                        11
                    ),

                PaddingRight =
                    UDim.new(
