local Roact = require(game:GetService("ReplicatedStorage").Roact) 
local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local FlyEvent = ReplicatedStorage:WaitForChild("FlyEvent") -- ServerScriptServiceと連携

-- 現在のプレイヤーのHumanoidを取得
local function getHumanoid()
    if Player and Player.Character then
        return Player.Character:FindFirstChildOfClass("Humanoid")
    end
    return nil
end

-- Fly機能のローカル制御 (W, A, S, Dキーで飛行)
local function setFlyMode(enabled, speed)
    local humanoid = getHumanoid()
    if not humanoid then return end

    if enabled then
        -- クライアント側で飛行状態を設定
        humanoid.PlatformStand = true
        humanoid.WalkSpeed = speed
    else
        -- 飛行を終了
        humanoid.PlatformStand = false
        humanoid.WalkSpeed = 16 -- デフォルト速度に戻す
    end
    
    -- サーバーにも通知
    FlyEvent:FireServer("ToggleFly", enabled)
    Player:SetAttribute("IsFlying", enabled)
end

