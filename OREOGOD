-- スライダーコンポーネント (変更なし、ただしMin/Maxは0-100/200に戻す)
local Slider = Roact.Component:extend("Slider")
function Slider:render()
    local props = self.props
    local title = props.Title
    local currentValue = props.CurrentValue 
    local onValueChanged = props.OnValueChanged
    local minValue = props.MinValue or 0
    local maxValue = props.MaxValue or 100

    return Roact.createElement("Frame", {
        Size = UDim2.new(1, -20, 0, 40),
        Position = UDim2.new(0.5, 0, 0, 0),
        LayoutOrder = props.LayoutOrder,
        AnchorPoint = Vector2.new(0.5, 0),
        BackgroundColor3 = Color3.new(0.35, 0.35, 0.35),
    }, {
        Title = Roact.createElement("TextLabel", {
            Text = title .. ": " .. string.format("%.0f", currentValue) .. " (" .. minValue .. "-" .. maxValue .. ")",
            Size = UDim2.new(0.5, 0, 1, 0),
            Position = UDim2.new(0, 5, 0, 0),
            AnchorPoint = Vector2.new(0, 0),
            BackgroundColor3 = Color3.new(0.35, 0.35, 0.35),
            TextColor3 = Color3.new(1, 1, 1),
            TextXAlignment = Enum.TextXAlignment.Left,
        }),
        InputBox = Roact.createElement("TextBox", {
            Size = UDim2.new(0.45, 0, 0.7, 0),
            Position = UDim2.new(1, -5, 0.5, 0),
            AnchorPoint = Vector2.new(1, 0.5),
            BackgroundColor3 = Color3.new(0.2, 0.2, 0.2),
            Text = tostring(math.floor(currentValue)),
            TextEditable = true,
            
            Event = {
                FocusLost = function(textBox, enterPressed)
                    if enterPressed then
                        local newValue = tonumber(textBox.Text)
                        if newValue then
                            local clampedValue = math.min(maxValue, math.max(minValue, newValue))
                            onValueChanged(clampedValue)
                        end
                    end
                end,
            }
        })
    })
end

-- トグルボタンコンポーネント
local ToggleButton = Roact.Component:extend("ToggleButton")
function ToggleButton:render()
    local props = self.props
    local title = props.Title
    local isToggled = props.IsToggled
    local onClick = props.OnClick

    local buttonColor = isToggled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0) -- 緑/赤
    local statusText = isToggled and "ON" or "OFF"

    return Roact.createElement("TextButton", {
        Size = UDim2.new(1, -20, 0, 40),
        Position = UDim2.new(0.5, 0, 0, 0),
        LayoutOrder = props.LayoutOrder,
        AnchorPoint = Vector2.new(0.5, 0),
        BackgroundColor3 = buttonColor,
        TextColor3 = Color3.new(1, 1, 1),
        Text = title .. ": " .. statusText,
        Event = {
            MouseButton1Click = onClick
        }
    })
end


local SettingsPanel = Roact.Component:extend("SettingsPanel")

function SettingsPanel:init()
    local initialSpeed = 16 
    local initialJumpPower = 50 
    local initialFlySpeed = 50 

    self:setState({
        isVisible = false,
        activeTab = 1,
        color = Color3.new(0.3, 0.3, 0.3),
        walkSpeed = initialSpeed,
        jumpPower = initialJumpPower,
        isFlying = false,          -- 新しい状態：飛行トグル
        flySpeed = initialFlySpeed, -- 新しい状態：飛行速度
    })
    
    RunService.Heartbeat:Wait()
    local humanoid = getHumanoid()
    if humanoid then
        humanoid.WalkSpeed = initialSpeed
        humanoid.JumpPower = initialJumpPower
    end
end

