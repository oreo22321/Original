function SettingsPanel:render()
    local state = self.state

    local function togglePanel()
        self:setState({ isVisible = not state.isVisible })
    end

    -- 色スライダーの値が変更されたときに呼ばれる関数 (省略)
    local function onColorChanged(colorComponent, newValue)
        local currentColor = state.color
        local newColor = Color3.new(currentColor.R, currentColor.G, currentColor.B)
        if colorComponent == "R" then
            newColor = Color3.new(newValue, newColor.G, newColor.B)
        elseif colorComponent == "G" then
            newColor = Color3.new(newColor.R, newValue, newColor.B)
        elseif colorComponent == "B" then
            newColor = Color3.new(newColor.R, newColor.G, newValue)
        end
        self:setState({ color = newColor })
    end
    
    -- 能力スライダーの値が変更されたときに呼ばれる関数
    local function onAbilityChanged(ability, newValue)
        local humanoid = getHumanoid()
        
        if ability == "WalkSpeed" then
            self:setState({ walkSpeed = newValue })
            if humanoid and not state.isFlying then -- 飛行中は通常速度を変えない
                humanoid.WalkSpeed = newValue
            end
        elseif ability == "JumpPower" then
            self:setState({ jumpPower = newValue })
            if humanoid then
                humanoid.JumpPower = newValue
            end
        end
    end
    
    -- Fly設定が変更されたときに呼ばれる関数
    local function onFlyChanged(action, value)
        if action == "Toggle" then
            self:setState({ isFlying = value })
            setFlyMode(value, state.flySpeed) -- Fly機能の実行/停止
            FlyEvent:FireServer("ToggleFly", value) -- サーバーに通知
            
        elseif action == "Speed" then
            self:setState({ flySpeed = value })
            if state.isFlying then
                setFlyMode(true, value) -- 飛行中の場合は即座に速度を適用
            end
            FlyEvent:FireServer("SetFlySpeed", value) -- サーバーに通知
        end
    end
    
    local function setActiveTab(tabIndex)
        self:setState({ activeTab = tabIndex })
    end

    -- 現在アクティブなタブの内容
    local activeTabContent = {}
    if state.activeTab == 1 then
        activeTabContent.TabContent = renderColorTab(state, onColorChanged)
    elseif state.activeTab == 2 then
        activeTabContent.TabContent = renderAbilityTab(state, onAbilityChanged)
    elseif state.activeTab == 3 then
        activeTabContent.TabContent = renderFlyTab(state, onFlyChanged)
    end
    
    local function getTabButtonProps(tabIndex)
        local isActive = state.activeTab == tabIndex
        return {
            Size = UDim2.new(1/3, 0, 0, 30), -- 3つ目のタブに合わせてサイズ変更
            BackgroundColor3 = isActive and Color3.fromRGB(80, 80, 80) or Color3.fromRGB(50, 50, 50),
            TextColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.SourceSansBold,
            TextSize = 16,
            Event = {
                MouseButton1Click = function() setActiveTab(tabIndex) end
            }
        }
    end

    return Roact.createElement("ScreenGui", {}, {
        -- 画面右上に表示する設定ボタン (省略)
        ToggleButton = Roact.createElement("TextButton", {
            Text = "設定", Size = UDim2.new(0, 80, 0, 40),
            Position = UDim2.new(1, -85, 0, 5), AnchorPoint = Vector2.new(0, 0),
            BackgroundColor3 = Color3.fromRGB(50, 50, 50), TextColor3 = Color3.new(1, 1, 1),
            Event = { MouseButton1Click = togglePanel }
        }),

        -- 設定パネル本体
        MainFrame = Roact.createElement("Frame", {
            Size = UDim2.new(0.4, 0, 0.6, 0), Position = UDim2.new(0.5, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(30, 30, 30),
            BorderColor3 = Color3.fromRGB(0, 0, 0), BorderSizePixel = 2, Visible = state.isVisible
        }, {
            -- タブボタンを横に並べるレイアウト
            TabContainer = Roact.createElement("Frame", {
                Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(40, 40, 40),
            }, {
                TabListLayout = Roact.createElement("UIListLayout", {
                    FillDirection = Enum.FillDirection.Horizontal,
                    HorizontalAlignment = Enum.HorizontalAlignment.Left,
                    SortOrder = Enum.SortOrder.LayoutOrder,
                }),
                -- タブ1ボタン
                Tab1 = Roact.createElement("TextButton", getTabButtonProps(1), { Text = "色" }),
                -- タブ2ボタン
                Tab2 = Roact.createElement("TextButton", getTabButtonProps(2), { Text = "能力" }),
                -- タブ3ボタン
                Tab3 = Roact.createElement("TextButton", getTabButtonProps(3), { Text = "Fly" }),
            }),
            
            -- タブの内容
            activeTabContent
        })
    })
end

