-- Rayfieldライブラリのロード（通常、Executorによって提供される）
local Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/UI-GS/Rayfield/main/Source'))()

-- GUIのウィンドウを作成
local Window = Rayfield:CreateWindow({
    Name = "My Rayfield Script", -- ウィンドウのタイトル
    LoadingTitle = "Initializing", -- ロード中のタイトル
    LoadingSubtitle = "by Gemini", -- ロード中のサブタイトル
    ConfigurationSaving = {
        Enabled = true, -- 設定を保存するかどうか
        FolderName = nil, -- 保存フォルダ名（nilでデフォルト）
        FileName = "RayfieldExample" -- ファイル名
    },
    DiscordInfo = {
        Enabled = false, -- Discord情報の表示
        Invite = "なし", -- 招待コード
        GroupName = "なし" -- グループ名
    },
    Keybind = Enum.KeyCode.RightControl -- ウィンドウの表示/非表示のキーバインド（例: Ctrlキー）
})

-- 新しいタブを作成: 'Home' タブ
local Tab = Window:CreateTab("Home", 
    nil -- アイコンのID (例: 4483536858)
)

-- 新しいセクションを作成: 'Player Settings' セクション
local Section = Tab:CreateSection("Player Settings")

-- スライダーを作成: WalkSpeedの変更
local WalkSpeedSlider = Tab:CreateSlider({
    Name = "WalkSpeed Changer",
    Description = "Change the speed of your character.",
    Range = {16, 100}, -- 最小値16（デフォルト）から最大値100
    Increment = 1, -- 増加単位
    Suffix = " studs/s",
    CurrentValue = 16,
    Callback = function(value)
        -- スライダーの値が変更されたときに実行される
        local Player = game.Players.LocalPlayer
        if Player.Character and Player.Character:FindFirstChild("Humanoid") then
            Player.Character.Humanoid.WalkSpeed = value
        end
    end
})

-- トグルボタンを作成: No-Clip
local NoClipToggle = Tab:CreateToggle({
    Name = "No-Clip",
    Description = "Toggle ability to walk through walls.",
    CurrentValue = false,
    Callback = function(isToggled)
        -- トグルの状態が変更されたときに実行される
        local Player = game.Players.LocalPlayer
        local Character = Player.Character or Player.CharacterAdded:Wait()

        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = not isToggled -- トグルがONなら衝突判定を無効に
            end
        end
    end
})

-- ボタンを作成: テレポート
local TeleportButton = Tab:CreateButton({
    Name = "Teleport to Spawn",
    Description = "Teleport your character to the default spawn point.",
    Callback = function()
        -- ボタンが押されたときに実行される
        local Player = game.Players.LocalPlayer
        local Character = Player.Character or Player.CharacterAdded:Wait()
        local Spawn = game.Workspace:FindFirstChild("SpawnLocation") or game.Workspace:FindFirstChildOfClass("SpawnLocation")
        
        if Spawn then
            Character:SetPrimaryPartCFrame(Spawn.CFrame + Vector3.new(0, 5, 0)) -- スポーン地点に少し浮かせた位置へテレポート
        end
    end
})

-- GUIを最終的に表示する
Rayfield:Notify({
    Title = "Rayfield Loaded!",
    Content = "The custom menu is ready to use.",
    Duration = 5,
    Image = nil,
    Icon = "info" 
})
