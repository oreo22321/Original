-- ============================================================
-- Utility
-- ============================================================

local function DeepCopy(tbl)
    local copy = {}

    for k, v in pairs(tbl) do
        if type(v) == "table" then
            copy[k] = DeepCopy(v)
        else
            copy[k] = v
        end
    end

    return copy
end

local function Merge(base, override)
    local result = DeepCopy(base)

    if type(override) ~= "table" then
        return result
    end

    for k, v in pairs(override) do
        if type(v) == "table"
            and type(result[k]) == "table" then

            result[k] = Merge(result[k], v)
        else
            result[k] = v
        end
    end

    return result
end

local function Create(className, properties, children)
    local object = Instance.new(className)

    for key, value in pairs(properties or {}) do
        if key ~= "Parent" then
            pcall(function()
                object[key] = value
            end)
        end
    end

    for _, child in ipairs(children or {}) do
        child.Parent = object
    end

    if properties and properties.Parent then
        object.Parent = properties.Parent
    end

    return object
end

local function SafeCallback(callback, ...)
    if typeof(callback) ~= "function" then
        return
    end

    local args = table.pack(...)

    task.spawn(function()
        local ok, err = pcall(function()
            callback(table.unpack(args, 1, args.n))
        end)

        if not ok then
            warn("[MonochromeUI] Callback error:", err)
        end
    end)
end

local function FormatNumber(value)
    value = tonumber(value) or 0

    if math.abs(value - math.round(value)) < 0.000001 then
        return tostring(math.round(value))
    end

    return string.format("%.3f", value)
        :gsub("0+$", "")
        :gsub("%.$", "")
end

local function IsActivateInput(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function IsPointerMovement(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

local function ClampColor(color)
    if typeof(color) ~= "Color3" then
        return Color3.new(1, 1, 1)
    end

    return Color3.new(
        math.clamp(color.R, 0, 1),
        math.clamp(color.G, 0, 1),
        math.clamp(color.B, 0, 1)
    )
end

local function ColorToString(color)
    color = ClampColor(color)

    return string.format(
        "%d,%d,%d",
        math.round(color.R * 255),
        math.round(color.G * 255),
        math.round(color.B * 255)
    )
end

local function Tween(object, info, properties)
    if not object or not object.Parent then
        return
    end

    local tween = TweenService:Create(
        object,
        info or TweenInfo.new(
            0.2,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        properties
    )

    tween:Play()

    return tween
end

-- ============================================================
-- Animation Manager
-- ============================================================

local AnimationManager = {}
AnimationManager.__index = AnimationManager

function AnimationManager.new()
    return setmetatable({
        Active = {},
    }, AnimationManager)
end

function AnimationManager:Play(object, info, properties, key)
    key = key or tostring(object)

    local old = self.Active[key]

    if old then
        pcall(function()
            old:Cancel()
        end)
    end

    local tween = Tween(object, info, properties)

    if tween then
        self.Active[key] = tween

        tween.Completed:Connect(function()
            if self.Active[key] == tween then
                self.Active[key] = nil
            end
        end)
    end

    return tween
end

function AnimationManager:Cancel(key)
    local tween = self.Active[key]

    if tween then
        pcall(function()
            tween:Cancel()
        end)

        self.Active[key] = nil
    end
end

function AnimationManager:Destroy()
    for key, tween in pairs(self.Active) do
        pcall(function()
            tween:Cancel()
        end)

        self.Active[key] = nil
    end
end

-- ============================================================
-- Connection Manager
-- ============================================================

local ConnectionManager = {}
ConnectionManager.__index = ConnectionManager

function ConnectionManager.new()
    return setmetatable({
        Connections = {},
    }, ConnectionManager)
end

function ConnectionManager:Connect(signal, callback)
    if not signal or typeof(callback) ~= "function" then
        return
    end

    local connection = signal:Connect(callback)

    table.insert(self.Connections, connection)

    return connection
end

function ConnectionManager:Add(connection)
    if connection then
        table.insert(self.Connections, connection)
    end

    return connection
end

function ConnectionManager:Disconnect(connection)
    if not connection then
        return
    end

    pcall(function()
        connection:Disconnect()
    end)

    for i, item in ipairs(self.Connections) do
        if item == connection then
            table.remove(self.Connections, i)
            break
        end
    end
end

function ConnectionManager:Clear()
    for _, connection in ipairs(self.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(self.Connections)
end

-- ============================================================
-- Base Element
-- ============================================================

local Component = {}
Component.__index = Component

function Component.new(window, object)
    return setmetatable({
        Window = window,
        Object = object,
        Connections = ConnectionManager.new(),
        Destroyed = false,
    }, Component)
end

function Component:Connect(signal, callback)
    if self.Destroyed then
        return
    end

    return self.Connections:Connect(signal, callback)
end

function Component:Destroy()
    if self.Destroyed then
        return
    end

    self.Destroyed = true

    self.Connections:Clear()

    if self.Object then
        self.Object:Destroy()
    end
end

-- ============================================================
-- Window
-- ============================================================

local Window = {}
Window.__index = Window

function Window:_Create(className, properties, children)
    properties = properties or {}
    properties.Parent = properties.Parent or self.ContentRoot

    return Create(className, properties, children)
end

function Window:_Tween(object, info, properties, key)
    return self.Animation:Play(
        object,
        info,
        properties,
        key
    )
end

function Window:_Connect(signal, callback)
    return self.Connections:Connect(signal, callback)
end

function Window:GetTheme()
    return DeepCopy(self.Theme)
end

function Window:SetTheme(theme)
    if typeof(theme) == "string" then
        local preset = Library.Themes[theme]

        if preset then
            self.Theme = DeepCopy(preset)
        end
    elseif typeof(theme) == "table" then
        self.Theme = Merge(self.Theme, theme)
    end

    self:_RefreshTheme()

    return self
end

function Window:SetAccent(color)
    if typeof(color) ~= "Color3" then
        return self
    end

    self.Theme.Accent = color
    self.Theme.AccentDark = color:Lerp(
        self.Theme.Background,
        0.25
    )

    self:_RefreshTheme()

    return self
end

function Window:SetScale(scale)
    scale = tonumber(scale) or 1
    scale = math.clamp(scale, 0.75, 1.5)

    self.ScaleValue = scale
    self.UIScale.Scale = scale

    return self
end

function Window:GetScale()
    return self.ScaleValue
end

function Window:SetPosition(position)
    if typeof(position) == "UDim2" then
        self.MainFrame.Position = position
        self.Config.Position = position
    end

    return self
end

function Window:GetPosition()
    return self.MainFrame.Position
end

function Window:SetSize(size)
    if typeof(size) == "UDim2" then
        self.MainFrame.Size = size
        self.Config.Size = size
    end

    return self
end

function Window:GetSize()
    return self.MainFrame.Size
end

function Window:SetVisible(state)
    state = state == true

    if self.Destroyed then
        return
    end

    if state == self.Visible then
        return
    end

    if state then
        self:Show()
    else
        self:Hide()
    end
end

function Window:Toggle()
    if self.Visible then
        self:Hide()
    else
        self:Show()
    end
end

function Window:Show()
    if self.Destroyed or self.Visible then
        return
    end

    self.Visible = true
    self.MinimizedButton.Visible = false
    self.MainFrame.Visible = true

    local targetSize = self.Config.Size

    self.MainFrame.Size = UDim2.new(
        0,
        0,
        0,
        0
    )

    self.MainFrame.BackgroundTransparency = 1

    self:_Tween(
        self.MainFrame,
        TweenInfo.new(
            0.36,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),
        {
            Size = targetSize,
            BackgroundTransparency = 0,
        },
        "WindowShow"
    )
end

function Window:Hide()
    if self.Destroyed or not self.Visible then
        return
    end

    self.Visible = false

    local tween = self:_Tween(
        self.MainFrame,
        TweenInfo.new(
            0.24,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.In
        ),
        {
            Size = UDim2.new(
                0,
                0,
                0,
                0
            ),

            BackgroundTransparency = 1,
        },
        "WindowHide"
    )

    if tween then
        self:_Connect(
            tween.Completed,
            function()
                if self.Destroyed or self.Visible then
                    return
                end

                self.MainFrame.Visible = false

                self.MinimizedButton.Visible = true
                self.MinimizedButton.Size = UDim2.new(
                    0,
                    0,
                    0,
                    0
                )

                self:_Tween(
                    self.MinimizedButton,
                    TweenInfo.new(
                        0.28,
                        Enum.EasingStyle.Back,
                        Enum.EasingDirection.Out
                    ),
                    {
                        Size = UDim2.new(
                            0,
                            44,
                            0,
                            44
                        ),
                    },
                    "MiniShow"
                )
            end
        )
    end
end

function Window:Minimize()
    self:Hide()
end

function Window:Restore()
    self:Show()
end

function Window:ToggleSidebar()
    if self.SidebarCollapsed then
        self:ExpandSidebar()
    else
        self:CollapseSidebar()
    end
end

function Window:CollapseSidebar()
    if self.SidebarCollapsed then
        return
    end

    self.SidebarCollapsed = true

    local sidebarWidth = self.Config.SidebarWidth
    local collapsedWidth = 54

    self:_Tween(
        self.Sidebar,
        nil,
        {
            Size = UDim2.new(
                0,
                collapsedWidth,
                1,
                -46
            ),
        },
        "SidebarSize"
    )

    self:_Tween(
        self.ContentArea,
        nil,
        {
            Position = UDim2.new(
                0,
                collapsedWidth + 8,
                0,
                52
            ),

            Size = UDim2.new(
                1,
                -(collapsedWidth + 18),
                1,
                -60
            ),
        },
        "ContentSize"
    )

    for _, tab in ipairs(self.Tabs) do
        tab:_UpdateCollapsed(true)
    end
end

function Window:ExpandSidebar()
    if not self.SidebarCollapsed then
        return
    end

    self.SidebarCollapsed = false

    local sidebarWidth = self.Config.SidebarWidth

    self:_Tween(
        self.Sidebar,
        nil,
        {
            Size = UDim2.new(
                0,
                sidebarWidth,
                1,
                -46
            ),
        },
        "SidebarSize"
    )

    self:_Tween(
        self.ContentArea,
        nil,
        {
            Position = UDim2.new(
                0,
                sidebarWidth + 8,
                0,
                52
            ),

            Size = UDim2.new(
                1,
                -(sidebarWidth + 18),
                1,
                -60
            ),
        },
        "ContentSize"
    )

    for _, tab in ipairs(self.Tabs) do
        tab:_UpdateCollapsed(false)
    end
end

function Window:_UpdateResponsive()
    if self.Destroyed then
        return
    end

    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    local viewport = camera.ViewportSize

    self.IsMobile = viewport.X <= 600

    if self.IsMobile then
        self.Config.SidebarWidth = 112

        self.Sidebar.Size = UDim2.new(
            0,
            112,
            1,
            -46
        )

        self.ContentArea.Position = UDim2.new(
            0,
            120,
            0,
            52
        )

        self.ContentArea.Size = UDim2.new(
            1,
            -130,
            1,
            -60
        )

        self.TitleLabel.TextSize = 16
    else
        self.Config.SidebarWidth = 154

        if not self.SidebarCollapsed then
            self.Sidebar.Size = UDim2.new(
                0,
                154,
                1,
                -46
            )

            self.ContentArea.Position = UDim2.new(
                0,
                162,
                0,
                52
            )

            self.ContentArea.Size = UDim2.new(
                1,
                -172,
                1,
                -60
            )
        end

        self.TitleLabel.TextSize = 18
    end
end

-- ============================================================
-- Theme Refresh
-- ============================================================

function Window:_RefreshTheme()
    local t = self.Theme

    self.MainFrame.BackgroundColor3 = t.Background
    self.Topbar.BackgroundColor3 = t.Topbar
    self.Sidebar.BackgroundColor3 = t.Sidebar

    if self.MainStroke then
        self.MainStroke.Color = t.Stroke
    end

    self.TitleLabel.TextColor3 = t.TextPrimary

    for _, object in ipairs(self.ThemeObjects) do
        local themeKey = object.__ThemeKey

        if themeKey and t[themeKey] ~= nil then
            pcall(function()
                object.Instance[object.Property] = t[themeKey]
            end)
        end
    end

    for _, tab in ipairs(self.Tabs) do
        tab:_RefreshTheme()
    end

    for _, notification in ipairs(self.Notifications) do
        if notification.Refresh then
            notification.Refresh()
        end
    end
end

function Window:_BindTheme(instance, property, themeKey)
    table.insert(
        self.ThemeObjects,
        {
            Instance = instance,
            Property = property,
            __ThemeKey = themeKey,
        }
    )

    local value = self.Theme[themeKey]

    if value ~= nil then
        pcall(function()
            instance[property] = value
        end)
    end

    return instance
end

-- ============================================================
-- Notification
-- ============================================================

function Window:Notify(config)
    config = config or {}

    local title = tostring(config.Title or "NOTICE")
    local text = tostring(config.Text or "")
    local duration = tonumber(config.Duration) or 3

    duration = math.max(duration, 0.5)

    local notification = Create("Frame", {
        Name = "Notification",

        Size = UDim2.new(
            0,
            310,
            0,
            82
        ),

        Position = UDim2.new(
            1,
            330,
            1,
            -18
        ),

        AnchorPoint = Vector2.new(1, 1),

        BackgroundColor3 = self.Theme.Topbar,

        BorderSizePixel = 0,

        Parent = self.NotificationHolder,
    }, {
        Create("UICorner", {
            CornerRadius = self.Theme.CornerRadius,
        }),

        Create("UIStroke", {
            Color = self.Theme.Stroke,
            Thickness = 1,
        }),
    })

    local accent = Create("Frame", {
        Size = UDim2.new(
            0,
            3,
            1,
            -14
        ),

        Position = UDim2.new(
            0,
            7,
            0,
            7
        ),

        BackgroundColor3 = self.Theme.Accent,

        BorderSizePixel = 0,

        Parent = notification,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }),
    })

    local titleLabel = Create("TextLabel", {
        Size = UDim2.new(
            1,
            -38,
            0,
            22
        ),

        Position = UDim2.new(
            0,
            22,
            0,
            9
        ),

        BackgroundTransparency = 1,

        Text = title,
        TextColor3 = self.Theme.TextPrimary,

        TextSize = 13,
        Font = self.Theme.TitleFont,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = notification,
    })

    local textLabel = Create("TextLabel", {
        Size = UDim2.new(
            1,
            -38,
            0,
            38
        ),

        Position = UDim2.new(
            0,
            22,
            0,
            32
        ),

        BackgroundTransparency = 1,

        Text = text,
        TextColor3 = self.Theme.TextSecondary,

        TextSize = 11,
        Font = self.Theme.Font,

        TextWrapped = true,

        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,

        Parent = notification,
    })

    local refresh = function()
        if not notification.Parent then
            return
        end

        notification.BackgroundColor3 = self.Theme.Topbar
        accent.BackgroundColor3 = self.Theme.Accent
        titleLabel.TextColor3 = self.Theme.TextPrimary
        textLabel.TextColor3 = self.Theme.TextSecondary
    end

    table.insert(self.Notifications, {
        Object = notification,
        Refresh = refresh,
    })

    self:_Tween(
        notification,
        TweenInfo.new(
            0.34,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        {
            Position = UDim2.new(
                1,
                -18,
                1,
                -18
            ),
        },
        "Notification_" .. tostring(notification)
    )

    task.delay(
        duration,
        function()
            if self.Destroyed or not notification.Parent then
                return
            end

            local tween = self:_Tween(
                notification,
                TweenInfo.new(
                    0.25,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.In
                ),
                {
                    Position = UDim2.new(
                        1,
                        330,
                        1,
                        -18
                    ),
                }
            )

            if tween then
                tween.Completed:Wait()
            end

            if notification.Parent then
                notification:Destroy()
            end
        end
    )

    return notification
end

-- ============================================================
-- Search
-- ============================================================

function Window:_RegisterSearchable(component, title)
    if not title then
        return
    end

    component.SearchTitle = tostring(title):lower()

    table.insert(
        self.Searchables,
        component
    )
end

function Window:Search(query)
    query = tostring(query or ""):lower()

    for _, component in ipairs(self.Searchables) do
        if component.Object and component.Object.Parent then
            local visible

            if query == "" then
                visible = true
            else
                visible = component.SearchTitle:find(
                    query,
                    1,
                    true
                ) ~= nil
            end

            component.Object.Visible = visible
        end
    end
end

function Window:ClearSearch()
    self:Search("")
end

-- ============================================================
-- Config
-- ============================================================

function Window:GetConfig()
    return {
        Theme = DeepCopy(self.Theme),
        Scale = self.ScaleValue,
        Position = self.MainFrame.Position,
        Size = self.MainFrame.Size,
        SidebarCollapsed = self.SidebarCollapsed,
    }
end

function Window:ApplyConfig(config)
    if typeof(config) ~= "table" then
        return self
    end

    if config.Theme then
        self:SetTheme(config.Theme)
    end

    if config.Scale then
        self:SetScale(config.Scale)
    end

    if typeof(config.Position) == "UDim2" then
        self:SetPosition(config.Position)
    end

    if typeof(config.Size) == "UDim2" then
        self:SetSize(config.Size)
    end

    if config.SidebarCollapsed then
        self:CollapseSidebar()
    else
        self:ExpandSidebar()
    end

    return self
end

-- ============================================================
-- Window Destroy
-- ============================================================

function Window:Destroy()
    if self.Destroyed then
        return
    end

    self.Destroyed = true

    self.Animation:Destroy()
    self.Connections:Clear()

    for _, tab in ipairs(self.Tabs) do
        tab:Destroy()
    end

    table.clear(self.Tabs)
    table.clear(self.Searchables)
    table.clear(self.ThemeObjects)
    table.clear(self.Notifications)

    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end

    for i, window in ipairs(Library.Windows) do
        if window == self then
            table.remove(Library.Windows, i)
            break
        end
    end
end

-- ============================================================
-- Window Creation
-- ============================================================

function Library:CreateWindow(config)
    config = config or {}

    local window = setmetatable({}, Window)

    window.Name = tostring(
        config.Name or "SYSTEM"
    )

    window.ToggleKey =
        config.ToggleKey
        or Enum.KeyCode.RightShift

    window.Theme = DeepCopy(
        self.Themes[config.Theme]
        or self.Themes.Dark
    )

    if typeof(config.Theme) == "table" then
        window.Theme = Merge(
            window.Theme,
            config.Theme
        )
    end

    window.ScaleValue = math.clamp(
        tonumber(config.Scale) or 1,
        0.75,
        1.5
    )

    window.Config = {
        Size = config.Size
            or UDim2.new(
                0,
                820,
                0,
                560
            ),

        Position = config.Position
            or UDim2.new(
                0.5,
                0,
                0.5,
                0
            ),

        SidebarWidth = 154,

        Draggable = config.Draggable ~= false,
    }

    window.Tabs = {}
    window.Searchables = {}
    window.Notifications = {}
    window.ThemeObjects = {}

    window.Connections = ConnectionManager.new()
    window.Animation = AnimationManager.new()

    window.Destroyed = false
    window.Visible = true
    window.SidebarCollapsed = false

    -- Remove old MonochromeUI instance
    pcall(function()
        local old = CoreGui:FindFirstChild(
            "MonochromeUI"
        )

        if old then
            old:Destroy()
        end
    end)

    -- ========================================================
    -- ScreenGui
    -- ========================================================

    local screenGui = Create("ScreenGui", {
        Name = "MonochromeUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = false,

        DisplayOrder = 999,

        Parent = CoreGui,
    })

    window.ScreenGui = screenGui

    -- ========================================================
    -- UIScale
    -- ========================================================

    local uiScale = Create("UIScale", {
        Scale = window.ScaleValue,
        Parent = screenGui,
    })

    window.UIScale = uiScale

    -- ========================================================
    -- MainFrame
    -- ========================================================

    local mainFrame = Create("Frame", {
        Name = "MainFrame",

        Size = window.Config.Size,
        Position = window.Config.Position,

        AnchorPoint = Vector2.new(
            0.5,
            0.5
        ),

        BackgroundColor3 = window.Theme.Background,

        BorderSizePixel = 0,

        Parent = screenGui,
    }, {
        Create("UICorner", {
            CornerRadius = window.Theme.CornerRadius,
        }),

        Create("UISizeConstraint", {
            MinSize = Vector2.new(
                340,
