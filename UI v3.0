    window.MainFrame = mainFrame

    window.MainStroke = Create("UIStroke", {
        Color = window.Theme.Stroke,
        Thickness = 1,
    })

    window.MainStroke.Parent = mainFrame

    -- ========================================================
    -- Topbar
    -- ========================================================

    local topbar = Create("Frame", {
        Name = "Topbar",

        Size = UDim2.new(
            1,
            0,
            0,
            46
        ),

        BackgroundColor3 = window.Theme.Topbar,

        BorderSizePixel = 0,

        Parent = mainFrame,
    }, {
        Create("UICorner", {
            CornerRadius = window.Theme.CornerRadius,
        }),
    })

    window.Topbar = topbar

    local topbarLine = Create("Frame", {
        Size = UDim2.new(
            1,
            0,
            0,
            1
        ),

        Position = UDim2.new(
            0,
            0,
            1,
            -1
        ),

        BackgroundColor3 = window.Theme.Stroke,

        BorderSizePixel = 0,

        Parent = topbar,
    })

    window:_BindTheme(
        topbarLine,
        "BackgroundColor3",
        "Stroke"
    )

    local titleLabel = Create("TextLabel", {
        Size = UDim2.new(
            1,
            -150,
            1,
            0
        ),

        Position = UDim2.new(
            0,
            16,
            0,
            0
        ),

        BackgroundTransparency = 1,

        Text = window.Name,

        TextColor3 = window.Theme.TextPrimary,

        TextSize = 18,

        Font = window.Theme.TitleFont,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = topbar,
    })

    window.TitleLabel = titleLabel

    -- ========================================================
    -- Topbar Buttons
    -- ========================================================

    local function createTopButton(name, text, offset)
        local button = Create("TextButton", {
            Name = name,

            Size = UDim2.new(
                0,
                30,
                0,
                30
            ),

            Position = UDim2.new(
                1,
                offset,
                0.5,
                -15
            ),

            BackgroundColor3 = window.Theme.ElementBG,

            BorderSizePixel = 0,

            Text = text,

            TextColor3 = window.Theme.TextSecondary,

            TextSize = 16,

            Font = window.Theme.Font,

            AutoButtonColor = false,

            Parent = topbar,
        }, {
            Create("UICorner", {
                CornerRadius = UDim.new(
                    0,
                    4
                ),
            }),
        })

        window:_Connect(
            button.MouseEnter,
            function()
                window:_Tween(
                    button,
                    nil,
                    {
                        BackgroundColor3 =
                            window.Theme.ElementHover,

                        TextColor3 =
                            window.Theme.TextPrimary,
                    }
                )
            end
        )

        window:_Connect(
            button.MouseLeave,
            function()
                window:_Tween(
                    button,
                    nil,
                    {
                        BackgroundColor3 =
                            window.Theme.ElementBG,

                        TextColor3 =
                            window.Theme.TextSecondary,
                    }
                )
            end
        )

        return button
    end

    local collapseButton = createTopButton(
        "SidebarButton",
        "≡",
        -116
    )

    local minimizeButton = createTopButton(
        "MinimizeButton",
        "−",
        -78
    )

    local closeButton = createTopButton(
        "CloseButton",
        "×",
        -40
    )

    window.CollapseButton = collapseButton
    window.MinimizeButton = minimizeButton
    window.CloseButton = closeButton

    -- ========================================================
    -- Sidebar
    -- ========================================================

    local sidebar = Create("Frame", {
        Name = "Sidebar",

        Size = UDim2.new(
            0,
            154,
            1,
            -46
        ),

        Position = UDim2.new(
            0,
            0,
            0,
            46
        ),

        BackgroundColor3 = window.Theme.Sidebar,

        BorderSizePixel = 0,

        Parent = mainFrame,
    })

    window.Sidebar = sidebar

    local sidebarPadding = Create("UIPadding", {
        PaddingTop = UDim.new(
            0,
            10
        ),

        PaddingBottom = UDim.new(
            0,
            10
        ),

        PaddingLeft = UDim.new(
            0,
            9
        ),

        PaddingRight = UDim.new(
            0,
            9
        ),

        Parent = sidebar,
    })

    local sidebarLayout = Create("UIListLayout", {
        Padding = UDim.new(
            0,
            6
        ),

        SortOrder = Enum.SortOrder.LayoutOrder,

        Parent = sidebar,
    })

    window.TabContainer = sidebar

    -- ========================================================
    -- Search Bar
    -- ========================================================

    local searchFrame = Create("Frame", {
        Size = UDim2.new(
            1,
            -210,
            0,
            34
        ),

        Position = UDim2.new(
            0,
            200,
            0,
            6
        ),

        BackgroundColor3 = window.Theme.ElementBG,

        BorderSizePixel = 0,

        Parent = topbar,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                4
            ),
        }),
    })

    local searchIcon = Create("TextLabel", {
        Size = UDim2.new(
            0,
            24,
            1,
            0
        ),

        Position = UDim2.new(
            0,
            8,
            0,
            0
        ),

        BackgroundTransparency = 1,

        Text = "⌕",

        TextColor3 = window.Theme.TextSecondary,

        TextSize = 16,

        Font = window.Theme.Font,

        Parent = searchFrame,
    })

    local searchBox = Create("TextBox", {
        Size = UDim2.new(
            1,
            -38,
            1,
            0
        ),

        Position = UDim2.new(
            0,
            32,
            0,
            0
        ),

        BackgroundTransparency = 1,

        ClearTextOnFocus = false,

        PlaceholderText = "Search...",

        PlaceholderColor3 = window.Theme.TextSecondary,

        Text = "",

        TextColor3 = window.Theme.TextPrimary,

        TextSize = 12,

        Font = window.Theme.Font,

        TextXAlignment = Enum.TextXAlignment.Left,

        Parent = searchFrame,
    })

    window.SearchBox = searchBox
    window.SearchFrame = searchFrame

    -- ========================================================
    -- ContentArea
    -- ========================================================

    local contentArea = Create("ScrollingFrame", {
        Name = "ContentArea",

        Size = UDim2.new(
            1,
            -172,
            1,
            -60
        ),

        Position = UDim2.new(
            0,
            162,
            0,
            52
        ),

        BackgroundTransparency = 1,

        BorderSizePixel = 0,

        ScrollBarThickness = 3,

        ScrollBarImageColor3 =
            window.Theme.Accent,

        CanvasSize = UDim2.new(
            0,
            0,
            0,
            0
        ),

        AutomaticCanvasSize =
            Enum.AutomaticSize.Y,

        ScrollingDirection =
            Enum.ScrollingDirection.Y,

        Parent = mainFrame,
    }, {
        Create("UIPadding", {
            PaddingTop = UDim.new(
                0,
                4
            ),

            PaddingBottom = UDim.new(
                0,
                8
            ),

            PaddingLeft = UDim.new(
                0,
                2
            ),

            PaddingRight = UDim.new(
                0,
                6
            ),
        }),
    })

    window.ContentArea = contentArea

    local contentLayout = Create("UIListLayout", {
        Padding = UDim.new(
            0,
            9
        ),

        SortOrder = Enum.SortOrder.LayoutOrder,

        Parent = contentArea,
    })

    window.ContentRoot = contentArea

    -- ========================================================
    -- Notifications
    -- ========================================================

    local notificationHolder = Create("Frame", {
        Name = "NotificationHolder",

        Size = UDim2.new(
            0,
            330,
            1,
            -20
        ),

        Position = UDim2.new(
            1,
            -10,
            0,
            10
        ),

        AnchorPoint = Vector2.new(
            1,
            0
        ),

        BackgroundTransparency = 1,

        Parent = screenGui,
    }, {
        Create("UIListLayout", {
            FillDirection =
                Enum.FillDirection.Vertical,

            HorizontalAlignment =
                Enum.HorizontalAlignment.Right,

            VerticalAlignment =
                Enum.VerticalAlignment.Bottom,

            Padding = UDim.new(
                0,
                8
            ),
        }),
    })

    window.NotificationHolder =
        notificationHolder

    -- ========================================================
    -- Minimized Button
    -- ========================================================

    local miniButton = Create("TextButton", {
        Name = "MinimizedButton",

        Size = UDim2.new(
            0,
            44,
            0,
            44
        ),

        Position = UDim2.new(
            0,
            20,
            0.5,
            -22
        ),

        BackgroundColor3 = window.Theme.Background,

        BorderSizePixel = 0,

        Text = string.sub(
            window.Name,
            1,
            1
        ),

        TextColor3 = window.Theme.TextPrimary,

        TextSize = 18,

        Font = window.Theme.TitleFont,

        AutoButtonColor = false,

        Visible = false,

        Parent = screenGui,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                6
            ),
        }),

        Create("UIStroke", {
            Color = window.Theme.Stroke,

            Thickness = 1,
        }),
    })

    window.MinimizedButton = miniButton

    -- ========================================================
    -- Search Events
    -- ========================================================

    window:_Connect(
        searchBox:GetPropertyChangedSignal(
            "Text"
        ),
        function()
            window:Search(
                searchBox.Text
            )
        end
    )

    -- ========================================================
    -- Button Events
    -- ========================================================

    window:_Connect(
        closeButton.MouseButton1Click,
        function()
            window:Hide()
        end
    )

    window:_Connect(
        minimizeButton.MouseButton1Click,
        function()
            window:Hide()
        end
    )

    window:_Connect(
        collapseButton.MouseButton1Click,
        function()
            window:ToggleSidebar()
        end
    )

    window:_Connect(
        miniButton.MouseButton1Click,
        function()
            window:Show()
        end
    )

    -- ========================================================
    -- Drag
    -- ========================================================

    local dragging = false
    local dragInput
    local dragStart
    local startPosition

    if window.Config.Draggable then
        window:_Connect(
            topbar.InputBegan,
            function(input, processed)
                if processed then
                    return
                end

                if IsActivateInput(input) then
                    dragging = true
                    dragInput = input
                    dragStart = input.Position
                    startPosition = mainFrame.Position
                end
            end
        )

        window:_Connect(
            topbar.InputEnded,
            function(input)
                if IsActivateInput(input)
                    and input == dragInput then

                    dragging = false
                    dragInput = nil
                end
            end
        )

        window:_Connect(
            UserInputService.InputChanged,
            function(input)
                if not dragging then
                    return
                end

                if not IsPointerMovement(input) then
                    return
                end

                local delta =
                    input.Position - dragStart

                mainFrame.Position =
                    UDim2.new(
                        startPosition.X.Scale,
                        startPosition.X.Offset
                            + delta.X,

                        startPosition.Y.Scale,
                        startPosition.Y.Offset
                            + delta.Y
                    )

                window.Config.Position =
                    mainFrame.Position
            end
        )
    end

    -- ========================================================
    -- Mobile / Viewport
    -- ========================================================

    local function connectCamera()
        local camera = workspace.CurrentCamera

        if not camera then
            return
        end

        return window:_Connect(
            camera:GetPropertyChangedSignal(
                "ViewportSize"
            ),
            function()
                window:_UpdateResponsive()
            end
        )
    end

    connectCamera()

    window:_UpdateResponsive()

    -- ========================================================
    -- Toggle Key
    -- ========================================================

    window:_Connect(
        UserInputService.InputBegan,
        function(input, processed)
            if processed then
                return
            end

            if input.KeyCode ==
                window.ToggleKey then

                window:Toggle()
            end
        end
    )

    -- ========================================================
    -- Window API Aliases
    -- ========================================================

    function window:GetTab(name)
        name = tostring(name or ""):lower()

        for _, tab in ipairs(self.Tabs) do
            if tab.Name:lower() == name then
                return tab
            end
        end
    end

    function window:SelectTab(name)
        local tab = self:GetTab(name)

        if tab then
            tab:Select()
            return tab
        end
    end

    function window:SetToggleKey(keyCode)
        if typeof(keyCode) ==
            "EnumItem" then

            self.ToggleKey = keyCode
        end

        return self
    end

    -- ========================================================
    -- Register Window
    -- ========================================================

    table.insert(
        Library.Windows,
        window
    )

    if config.AutoNotify then
        task.defer(function()
            window:Notify({
                Title = window.Name,
                Text = "UI initialized.",
                Duration = 2,
            })
        end)
    end

    return window
end

-- ============================================================
-- Tab
-- ============================================================

local Tab = {}
Tab.__index = Tab

function Window:CreateTab(name, icon)
    name = tostring(name or "TAB")

    local tab = setmetatable({
        Window = self,

        Name = name,

        Icon = icon,

        Sections = {},

        Components = {},

        Selected = false,

        Destroyed = false,
    }, Tab)

    -- ========================================================
    -- Tab Button
    -- ========================================================

    local button = Create("TextButton", {
        Name = name .. "_Button",

        Size = UDim2.new(
            1,
            0,
            0,
            38
        ),

        BackgroundColor3 =
            self.Theme.ElementBG,

        BorderSizePixel = 0,

        Text = "",

        AutoButtonColor = false,

        Parent = self.TabContainer,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                4
            ),
        }),
    })

    tab.Button = button

    local indicator = Create("Frame", {
        Size = UDim2.new(
            0,
            3,
            0.52,
            0
        ),

        Position = UDim2.new(
            0,
            0,
            0.24,
            0
        ),

        BackgroundColor3 =
            self.Theme.Accent,

        BackgroundTransparency = 1,

        BorderSizePixel = 0,

        Parent = button,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                1,
                0
            ),
        }),
    })

    tab.Indicator = indicator

    local iconLabel = Create("TextLabel", {
        Name = "Icon",

        Size = UDim2.new(
            0,
            28,
            1,
            0
        ),

        Position = UDim2.new(
            0,
            8,
            0,
            0
        ),

        BackgroundTransparency = 1,

        Text = icon
            and tostring(icon)
            or "•",

        TextColor3 =
            self.Theme.TextSecondary,

        TextSize = 14,

        Font = self.Theme.Font,

        TextXAlignment =
            Enum.TextXAlignment.Center,

        Parent = button,
    })

    tab.IconLabel = iconLabel

    local textLabel = Create("TextLabel", {
        Name = "Text",

        Size = UDim2.new(
            1,
            -44,
            1,
            0
        ),

        Position = UDim2.new(
            0,
            40,
            0,
            0
        ),

        BackgroundTransparency = 1,

        Text = name:upper(),

        TextColor3 =
            self.Theme.TextSecondary,

        TextSize = 12,

        Font = self.Theme.Font,

        TextXAlignment =
            Enum.TextXAlignment.Left,

        Parent = button,
    })

    tab.TextLabel = textLabel

    -- ========================================================
    -- Tab Content
    -- ========================================================

    local content = Create("Frame", {
        Name = name .. "_Content",

        Size = UDim2.new(
            1,
            0,
            0,
            0
        ),

        AutomaticSize =
            Enum.AutomaticSize.Y,

        BackgroundTransparency = 1,

        Visible = false,

        Parent = self.ContentArea,
    })

    local layout = Create("UIListLayout", {
        SortOrder =
            Enum.SortOrder.LayoutOrder,

        Padding = UDim.new(
            0,
            9
        ),

        Parent = content,
    })

    tab.Content = content
    tab.Layout = layout

    table.insert(
        self.Tabs,
        tab
    )

    -- ========================================================
    -- Select
    -- ========================================================

    function tab:Select()
        if self.Destroyed then
            return
        end

        for _, other in ipairs(
            self.Window.Tabs
        ) do
            local active =
                other == self

            other.Selected = active

            other.Content.Visible =
                active

            other.Window:_Tween(
                other.Button,
                nil,
                {
                    BackgroundColor3 =
                        active
                        and other.Window.Theme.Accent
                        or other.Window.Theme.ElementBG,

                    TextColor3 =
                        active
                        and other.Window.Theme.Background
                        or other.Window.Theme.TextSecondary,
                },
                "Tab_" .. other.Name
            )

            other.Window:_Tween(
                other.Indicator,
                nil,
                {
                    BackgroundTransparency =
                        active and 0 or 1,
                }
            )

            local targetColor =
                active
                and other.Window.Theme.Background
                or other.Window.Theme.TextSecondary

            other.IconLabel.TextColor3 =
                targetColor

            other.TextLabel.TextColor3 =
                targetColor
        end

        self.Content.CanvasPosition =
            Vector2.new(0, 0)
    end

    -- ========================================================
    -- Hover
    -- ========================================================

    tab:_Connect = function(signal, callback)
        return self.Window:_Connect(
            signal,
            callback
        )
    end

    tab:_Connect(
        button.MouseEnter,
        function()
            if tab.Selected then
                return
            end

            self:_Tween(
                button,
                nil,
                {
                    BackgroundColor3 =
                        self.Theme.ElementHover,
                }
            )
        end
    )

    tab:_Connect(
        button.MouseLeave,
        function()
            if tab.Selected then
                return
            end

            self:_Tween(
                button,
                nil,
                {
                    BackgroundColor3 =
                        self.Theme.ElementBG,
                }
            )
        end
    )

    tab:_Connect(
        button.MouseButton1Click,
        function()
            tab:Select()
        end
    )

    -- ========================================================
    -- Select First
    -- ========================================================

    if #self.Tabs == 1 then
        tab:Select()
    end

    return tab
end

function Tab:_UpdateCollapsed(collapsed)
    if collapsed then
        self.TextLabel.Visible = false

        self.Button.Size = UDim2.new(
            1,
            0,
            0,
            38
        )

        self.IconLabel.Size = UDim2.new(
            1,
            0,
            1,
            0
        )

        self.IconLabel.Position = UDim2.new(
            0,
            0,
            0,
            0
        )
    else
        self.TextLabel.Visible = true

        self.IconLabel.Size = UDim2.new(
            0,
            28,
            1,
            0
        )

        self.IconLabel.Position = UDim2.new(
            0,
            8,
            0,
            0
        )
    end
end

function Tab:_RefreshTheme()
    local t = self.Window.Theme

    self.Button.BackgroundColor3 =
        self.Selected
        and t.Accent
        or t.ElementBG

    self.Indicator.BackgroundColor3 =
        t.Accent

    local textColor =
        self.Selected
        and t.Background
        or t.TextSecondary

    self.IconLabel.TextColor3 =
        textColor

    self.TextLabel.TextColor3 =
        textColor
end

function Tab:CreateSection(title)
    title = tostring(title or "SECTION")

    local section = setmetatable({
        Window = self.Window,

        Tab = self,

        Name = title,

        Components = {},

        Destroyed = false,
    }, Component)

    -- ========================================================
    -- Section Frame
    -- ========================================================

    local frame = Create("Frame", {
        Name = title .. "_Section",

        Size = UDim2.new(
            1,
            0,
            0,
            0
        ),

        AutomaticSize =
            Enum.AutomaticSize.Y,

        BackgroundColor3 =
            self.Window.Theme.Background,

        BorderSizePixel = 0,

        Parent = self.Content,
    }, {
        Create("UICorner", {
            CornerRadius =
                self.Window.Theme.CornerRadius,
        }),

        Create("UIStroke", {
            Color =
                self.Window.Theme.Stroke,

            Thickness = 1,
        }),

        Create("UIPadding", {
            PaddingTop = UDim.new(
                0,
                11
            ),

            PaddingBottom = UDim.new(
                0,
                11
            ),

            PaddingLeft = UDim.new(
                0,
                11
            ),

            PaddingRight = UDim.new(
                0,
                11
            ),
        }),
    })

    section.Object = frame
    section.Frame = frame

    local header = Create("TextLabel", {
        Size = UDim2.new(
            1,
            0,
            0,
            18
        ),

        BackgroundTransparency = 1,

        Text = title:upper(),

        TextColor3 =
            self.Window.Theme.TextSecondary,

        TextSize = 11,

        Font = self.Window.Theme.TitleFont,

        TextXAlignment =
            Enum.TextXAlignment.Left,

        Parent = frame,
    })

    section.Header = header

    local layout = Create("UIListLayout", {
        SortOrder =
            Enum.SortOrder.LayoutOrder,

        Padding = UDim.new(
            0,
            7
        ),

        Parent = frame,
    })

    header.LayoutOrder = 0

    section._layout = layout

    table.insert(
        self.Sections,
        section
    )

    return section
end

-- ============================================================
-- Section Helpers
-- ============================================================

local SectionMethods = {}

function SectionMethods:_Add(component, title)
    if not component then
        return
    end

    table.insert(
        self.Components,
        component
    )

    self.Tab.Window:_RegisterSearchable(
        component,
        title
    )

    return component
end

function SectionMethods:_CreateBase(config, height)
    config = config or {}

    local frame = Create("Frame", {
        Size = UDim2.new(
            1,
            0,
            0,
            height
        ),

        BackgroundColor3 =
            self.Window.Theme.ElementBG,

        BorderSizePixel = 0,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                4
            ),
        }),
    })

    return frame
end

function SectionMethods:CreateDivider()
    local divider = Create("Frame", {
        Size = UDim2.new(
            1,
            0,
            0,
            1
        ),

        BackgroundColor3 =
            self.Window.Theme.Stroke,

        BorderSizePixel = 0,

        Parent = self.Frame,
    })

    local component = Component.new(
        self.Window,
        divider
    )

    return self:_Add(
        component,
        ""
    )
end

function SectionMethods:CreateLabel(config)
    config = config or {}

    local height =
        tonumber(config.Height) or 24

    local label = Create("TextLabel", {
        Size = UDim2.new(
            1,
            0,
            0,
            height
        ),

        BackgroundTransparency = 1,

        Text = tostring(
            config.Text or ""
        ),

        TextColor3 =
            config.Color
            or self.Window.Theme.TextSecondary,

        TextSize =
            tonumber(config.TextSize)
            or 12,

        Font =
            config.Font
            or self.Window.Theme.Font,

        TextWrapped =
            config.TextWrapped ~= false,

        TextXAlignment =
            config.TextXAlignment
            or Enum.TextXAlignment.Left,

        TextYAlignment =
            config.TextYAlignment
            or Enum.TextYAlignment.Center,

        Parent = self.Frame,
    })

    local component = Component.new(
        self.Window,
        label
    )

    function component:SetText(text)
        label.Text = tostring(text or "")
        return self
    end

    function component:SetColor(color)
        if typeof(color) == "Color3" then
            label.TextColor3 = color
        end

        return self
    end

    return self:_Add(
        component,
        config.Text
    )
end

function SectionMethods:CreateButton(config)
    config = config or {}

    local name = tostring(
        config.Name or "Button"
    )

    local button = Create("TextButton", {
        Name = name,

        Size = UDim2.new(
            1,
            0,
            0,
            tonumber(config.Height) or 34
        ),

        BackgroundColor3 =
            self.Window.Theme.ElementBG,

        BorderSizePixel = 0,

        Text = name,

        TextColor3 =
            self.Window.Theme.TextPrimary,

        TextSize =
            tonumber(config.TextSize)
            or 12,

        Font =
            config.Font
            or self.Window.Theme.Font,

        AutoButtonColor = false,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                4
            ),
        }),
    })

    local component = Component.new(
        self.Window,
        button
    )

    component._Enabled = true

    component:_Connect(
        button.MouseEnter,
        function()
            if component._Enabled then
                self.Window:_Tween(
                    button,
                    nil,
                    {
                        BackgroundColor3 =
                            self.Window.Theme.ElementHover,
                    }
                )
            end
        end
    )

    component:_Connect(
        button.MouseLeave,
        function()
            if component._Enabled then
                self.Window:_Tween(
                    button,
                    nil,
                    {
                        BackgroundColor3 =
                            self.Window.Theme.ElementBG,
                    }
                )
            end
        end
    )

    component:_Connect(
        button.MouseButton1Click,
        function()
            if component._Enabled then
                SafeCallback(
                    config.Callback
                )
            end
        end
    )

    function component:SetText(text)
        button.Text = tostring(text or "")
        return self
    end

    function component:SetEnabled(enabled)
        enabled = enabled ~= false

        self._Enabled = enabled
        button.Active = enabled
        button.Selectable = enabled

        button.TextColor3 =
            enabled
            and self.Window.Theme.TextPrimary
            or self.Window.Theme.TextDisabled

        return self
    end

    return self:_Add(
        component,
        name
    )
end

function SectionMethods:CreateToggle(config)
    config = config or {}

    local name = tostring(
        config.Name or "Toggle"
    )

    local state =
        config.Default == true

    local callback = config.Callback

    local frame = self:_CreateBase(
        config,
        38
    )

    local label = Create("TextLabel", {
        Size = UDim2.new(
            1,
            -62,
            1,
            0
        ),

        Position = UDim2.new(
            0,
            12,
            0,
            0
        ),

        BackgroundTransparency = 1,

        Text = name,

        TextColor3 =
            self.Window.Theme.TextPrimary,

        TextSize = 12,

        Font = self.Window.Theme.Font,

        TextXAlignment =
            Enum.TextXAlignment.Left,

        Parent = frame,
    })

    local track = Create("Frame", {
        Size = UDim2.new(
            0,
            38,
            0,
            20
        ),

        Position = UDim2.new(
            1,
            -50,
            0.5,
            -10
        ),

        BackgroundColor3 =
            self.Window.Theme.Track,

        BorderSizePixel = 0,

        Parent = frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                1,
                0
            ),
        }),
    })

    local knob = Create("Frame", {
        Size = UDim2.new(
            0,
            14,
            0,
            14
        ),

        Position = UDim2.new(
            0,
            3,
            0.5,
            -7
        ),

        BackgroundColor3 =
            self.Window.Theme.Accent,

        BorderSizePixel = 0,

        Parent = track,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                1,
                0
            ),
        }),
    })

    local click = Create("TextButton", {
        Size = UDim2.new(
            1,
            0,
            1,
            0
        ),

        BackgroundTransparency = 1,

        Text = "",

        AutoButtonColor = false,

        Parent = frame,
    })

    local component = Component.new(
        self.Window,
        frame
    )

    function component:SetState(value, fireCallback)
        state = value == true

        self.Window:_Tween(
            track,
            nil,
            {
                BackgroundColor3 =
                    state
                    and self.Window.Theme.Accent
                    or self.Window.Theme.Track,
            }
        )

        self.Window:_Tween(
            knob,
            TweenInfo.new(
                0.22,
                Enum.EasingStyle.Back,
                Enum.EasingDirection.Out
            ),
            {
                Position =
                    state
                    and UDim2.new(
                        1,
                        -17,
                        0.5,
                        -7
                    )
                    or UDim2.new(
                        0,
                        3,
                        0.5,
                        -7
                    ),

                BackgroundColor3 =
                    state
                    and self.Window.Theme.Background
                    or self.Window.Theme.Accent,
            }
        )

        if fireCallback ~= false then
            SafeCallback(
                callback,
                state
            )
        end

        return self
    end

    function component:GetState()
        return state
    end

    function component:Toggle()
        return self:SetState(
            not state,
            true
        )
    end

    component:_Connect(
        click.MouseEnter,
        function()
            self.Window:_Tween(
                frame,
                nil,
                {
                    BackgroundColor3 =
                        self.Window.Theme.ElementHover,
                }
            )
        end
    )

    component:_Connect(
        click.MouseLeave,
        function()
            self.Window:_Tween(
                frame,
                nil,
                {
                    BackgroundColor3 =
                        self.Window.Theme.ElementBG,
                }
            )
        end
    )

    component:_Connect(
        click.MouseButton1Click,
        function()
            component:Toggle()
        end
    )

    component:SetState(
        state,
        false
    )

    return self:_Add(
        component,
        name
    )
end

function SectionMethods:CreateSlider(config)
    config = config or {}

    local name = tostring(
        config.Name or "Slider"
    )

    local min =
        tonumber(config.Min)
        or 0

    local max =
        tonumber(config.Max)
        or 100

    local step =
        tonumber(config.Step)
        or 1

    if max < min then
        min, max = max, min
    end

    if step <= 0 then
        step = 1
    end

    local default =
        tonumber(config.Default)

    if default == nil then
        default = min
    end

    local callback = config.Callback

    local frame = self:_CreateBase(
        config,
        50
    )

    local title = Create("TextLabel", {
        Size = UDim2.new(
            0.7,
            0,
            0,
            18
        ),

        Position = UDim2.new(
            0,
            11,
            0,
            5
        ),

        BackgroundTransparency = 1,

        Text = name,

        TextColor3 =
            self.Window.Theme.TextPrimary,

        TextSize = 12,

        Font = self.Window.Theme.Font,

        TextXAlignment =
            Enum.TextXAlignment.Left,

        Parent = frame,
    })

    local valueLabel = Create("TextLabel", {
        Size = UDim2.new(
            0.25,
            0,
            0,
            18
        ),

        Position = UDim2.new(
            0.73,
            0,
            0,
            5
        ),

        BackgroundTransparency = 1,

        Text = FormatNumber(default),

        TextColor3 =
            self.Window.Theme.TextSecondary,

        TextSize = 11,

        Font = self.Window.Theme.Font,

        TextXAlignment =
            Enum.TextXAlignment.Right,

        Parent = frame,
    })

    local track = Create("Frame", {
        Size = UDim2.new(
            1,
            -22,
            0,
            6
        ),

        Position = UDim2.new(
            0,
            11,
            1,
            -13
        ),

        BackgroundColor3 =
            self.Window.Theme.Track,

        BorderSizePixel = 0,

        Parent = frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                1,
                0
            ),
        }),
    })

    local fill = Create("Frame", {
        Size = UDim2.new(
            0,
            0,
            1,
            0
        ),

        BackgroundColor3 =
            self.Window.Theme.Accent,

        BorderSizePixel = 0,

        Parent = track,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                1,
                0
            ),
        }),
    })

    local knob = Create("Frame", {
        Size = UDim2.new(
            0,
            14,
            0,
            14
        ),

        Position = UDim2.new(
            0,
            -7,
            0.5,
            -7
        ),

        BackgroundColor3 =
            self.Window.Theme.Accent,

        BorderSizePixel = 0,

        Parent = track,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                1,
                0
            ),
        }),
    })

    local component = Component.new(
        self.Window,
        frame
    )

    local value = default
    local dragging = false

    local function getRatio(number)
        local range = max - min

        if range <= 0 then
            return 0
        end

        return math.clamp(
            (number - min) / range,
            0,
            1
        )
    end

    local function snap(number)
        local result =
            min
            + math.round(
                (number - min) / step
            ) * step

        return math.clamp(
            result,
            min,
            max
        )
    end

    function component:SetValue(
        newValue,
        fireCallback
    )
        newValue = tonumber(newValue)

        if not newValue then
            return self
        end

        value = snap(newValue)

        local ratio = getRatio(value)

        fill.Size = UDim2.new(
            ratio,
            0,
            1,
            0
        )

        knob.Position = UDim2.new(
            ratio,
            -7,
            0.5,
            -7
        )

        valueLabel.Text =
            FormatNumber(value)

        if fireCallback ~= false then
            SafeCallback(
                callback,
                value
            )
        end

        return self
    end

    function component:GetValue()
        return value
    end

    local function updateFromInput(input)
        if track.AbsoluteSize.X <= 0 then
            return
        end

        local ratio =
            (
                input.Position.X
                - track.AbsolutePosition.X
            )
            / track.AbsoluteSize.X

        ratio = math.clamp(
            ratio,
            0,
            1
        )

        local newValue =
            min
            + (max - min)
            * ratio

        component:SetValue(
            newValue,
            true
        )
    end

    component:_Connect(
        track.InputBegan,
        function(input, processed)
            if processed then
                return
            end

            if IsActivateInput(input) then
                dragging = true
                updateFromInput(input)
            end
        end
    )

    component:_Connect(
        UserInputService.InputChanged,
        function(input)
            if dragging
                and IsPointerMovement(input) then

                updateFromInput(input)
            end
        end
    )

    component:_Connect(
        UserInputService.InputEnded,
        function(input)
            if IsActivateInput(input) then
                dragging = false
            end
        end
    )

    component:SetValue(
        default,
        false
    )

    return self:_Add(
        component,
        name
    )
end

function SectionMethods:CreateDropdown(config)
    config = config or {}

    local name = tostring(
        config.Name or "Dropdown"
    )

    local options = config.Options or {}

    local callback = config.Callback

    local selected =
        config.Default

    if selected == nil then
        selected = options[1]
    end

    local opened = false

    local headerHeight = 34

    local frame = Create("Frame", {
        Name = name,

        Size = UDim2.new(
            1,
            0,
            0,
            headerHeight
        ),

        BackgroundColor3 =
            self.Window.Theme.ElementBG,

        BorderSizePixel = 0,

        ClipsDescendants = true,

        Parent = self.Frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                4
            ),
        }),
    })

    local header = Create("TextButton", {
        Size = UDim2.new(
            1,
            0,
            0,
            headerHeight
        ),

        BackgroundTransparency = 1,

        Text = "",

        AutoButtonColor = false,

        Parent = frame,
    })

    local titleLabel = Create("TextLabel", {
        Size = UDim2.new(
            0.5,
            0,
            1,
            0
        ),

        Position = UDim2.new(
            0,
            11,
            0,
            0
        ),

        BackgroundTransparency = 1,

        Text = name,

        TextColor3 =
            self.Window.Theme.TextPrimary,

        TextSize = 12,

        Font = self.Window.Theme.Font,

        TextXAlignment =
            Enum.TextXAlignment.Left,

        Parent = header,
    })

    local selectedLabel = Create("TextLabel", {
        Size = UDim2.new(
            0.42,
            -12,
            1,
            0
        ),

        Position = UDim2.new(
            0.48,
            0,
            0,
            0
        ),

        BackgroundTransparency = 1,

        Text = tostring(
            selected or "Select..."
        ),

        TextColor3 =
            self.Window.Theme.TextSecondary,

        TextSize = 11,

        Font = self.Window.Theme.Font,

        TextXAlignment =
            Enum.TextXAlignment.Right,

        Parent = header,
    })

    local arrow = Create("TextLabel", {
        Size = UDim2.new(
            0,
            16,
            1,
            0
        ),

        Position = UDim2.new(
            1,
            -22,
            0,
            0
        ),

        BackgroundTransparency = 1,

        Text = "▼",

        TextColor3 =
            self.Window.Theme.TextSecondary,

        TextSize = 9,

        Font = self.Window.Theme.Font,

        Parent = header,
    })

    local list = Create("Frame", {
        Size = UDim2.new(
            1,
            0,
            0,
            0
        ),

        Position = UDim2.new(
            0,
            0,
            0,
            headerHeight
        ),

        BackgroundColor3 =
            self.Window.Theme.Topbar,

        BorderSizePixel = 0,

        Parent = frame,
    }, {
        Create("UIPadding", {
            PaddingTop = UDim.new(
                0,
                5
            ),

            PaddingBottom = UDim.new(
                0,
                5
            ),

            PaddingLeft = UDim.new(
                0,
                5
            ),

            PaddingRight = UDim.new(
                0,
                5
            ),
        }),

        Create("UIListLayout", {
            Padding = UDim.new(
                0,
                3
            ),

            SortOrder =
                Enum.SortOrder.LayoutOrder,
        }),
    })

    local component = Component.new(
        self.Window,
        frame
    )

    local items = {}

    for index, option in ipairs(options) do
        local item = Create("TextButton", {
            Name = "Option_" .. index,

            Size = UDim2.new(
                1,
                0,
                0,
                28
            ),

            BackgroundColor3 =
                self.Window.Theme.ElementBG,

            BorderSizePixel = 0,

            Text = tostring(option),

            TextColor3 =
                self.Window.Theme.TextPrimary,

            TextSize = 11,

            Font = self.Window.Theme.Font,

            AutoButtonColor = false,

            LayoutOrder = index,

            Parent = list,
        }, {
            Create("UICorner", {
                CornerRadius = UDim.new(
                    0,
                    3
                ),
            }),
        })

        table.insert(
            items,
            item
        )

        component:_Connect(
            item.MouseEnter,
            function()
                self.Window:_Tween(
                    item,
                    nil,
                    {
                        BackgroundColor3 =
                            self.Window.Theme.ElementHover,
                    }
                )
            end
        )

        component:_Connect(
            item.MouseLeave,
            function()
                self.Window:_Tween(
                    item,
                    nil,
                    {
                        BackgroundColor3 =
                            self.Window.Theme.ElementBG,
                    }
                )
            end
        )

        component:_Connect(
            item.MouseButton1Click,
            function()
                selected = option
                selectedLabel.Text =
                    tostring(option)

                SafeCallback(
                    callback,
                    option
                )

                component:Close()
            end
        )
    end

    local listHeight =
        (#items * 28)
        + math.max(0, #items - 1) * 3
        + 10

    function component:Open()
        if opened then
            return self
        end

        opened = true

        self.Window:_Tween(
            list,
            nil,
            {
                Size = UDim2.new(
                    1,
                    0,
                    0,
                    listHeight
                ),
            }
        )

        self.Window:_Tween(
            frame,
            nil,
            {
                Size = UDim2.new(
                    1,
                    0,
                    0,
                    headerHeight
                    + listHeight
                ),
            }
        )

        self.Window:_Tween(
            arrow,
            nil,
            {
                Rotation = 180,
            }
        )

        return self
    end

    function component:Close()
        if not opened then
            return self
        end

        opened = false

        self.Window:_Tween(
            list,
            nil,
            {
                Size = UDim2.new(
                    1,
                    0,
                    0,
                    0
                ),
            }
        )

        self.Window:_Tween(
            frame,
            nil,
            {
                Size = UDim2.new(
                    1,
                    0,
                    0,
                    headerHeight
                ),
            }
        )

        self.Window:_Tween(
            arrow,
            nil,
            {
                Rotation = 0,
            }
        )

        return self
    end

    function component:ToggleOpen()
        if opened then
            return self:Close()
        end

        return self:Open()
    end

    function component:SetValue(value)
        for _, option in ipairs(options) do
            if option == value then
                selected = value
                selectedLabel.Text =
                    tostring(value)

                return true
            end
        end

        return false
    end

    function component:GetSelected()
        return selected
    end

    component:_Connect(
        header.MouseEnter,
        function()
            self.Window:_Tween(
                frame,
                nil,
                {
                    BackgroundColor3 =
                        self.Window.Theme.ElementHover,
                }
            )
        end
    )

    component:_Connect(
        header.MouseLeave,
        function()
            self.Window:_Tween(
                frame,
                nil,
                {
                    BackgroundColor3 =
                        self.Window.Theme.ElementBG,
                }
            )
        end
    )

    component:_Connect(
        header.MouseButton1Click,
        function()
            component:ToggleOpen()
        end
    )

    return self:_Add(
        component,
        name
    )
end

function SectionMethods:CreateTextbox(config)
    config = config or {}

    local name = tostring(
        config.Name or "Textbox"
    )

    local frame = self:_CreateBase(
        config,
        tonumber(config.Height) or 42
    )

    local label = Create("TextLabel", {
        Size = UDim2.new(
            0.4,
            0,
            1,
            0
        ),

        Position = UDim2.new(
            0,
            11,
            0,
            0
        ),

        BackgroundTransparency = 1,

        Text = name,

        TextColor3 =
            self.Window.Theme.TextPrimary,

        TextSize = 12,

        Font = self.Window.Theme.Font,

        TextXAlignment =
            Enum.TextXAlignment.Left,

        Parent = frame,
    })

    local textbox = Create("TextBox", {
        Size = UDim2.new(
            0.55,
            0,
            0,
            30
        ),

        Position = UDim2.new(
            0.44,
            0,
            0.5,
            -15
        ),

        BackgroundColor3 =
            self.Window.Theme.Track,

        BorderSizePixel = 0,

        ClearTextOnFocus =
            config.ClearOnFocus == true,

        PlaceholderText =
            tostring(
                config.Placeholder
                or "Enter text..."
            ),

        PlaceholderColor3 =
            self.Window.Theme.TextSecondary,

        Text =
            tostring(
                config.Default or ""
            ),

        TextColor3 =
            self.Window.Theme.TextPrimary,

        TextSize = 11,

        Font = self.Window.Theme.Font,

        TextXAlignment =
            Enum.TextXAlignment.Left,

        Parent = frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                4
            ),
        }),

        Create("UIPadding", {
            PaddingLeft = UDim.new(
                0,
                8
            ),

            PaddingRight = UDim.new(
                0,
                8
            ),
        }),
    })

    local component = Component.new(
        self.Window,
        frame
    )

    component.TextBox = textbox

    component:_Connect(
        textbox.FocusLost,
        function(enterPressed)
            SafeCallback(
                config.Callback,
                textbox.Text,
                enterPressed
            )
        end
    )

    function component:SetText(text)
        textbox.Text = tostring(
            text or ""
        )

        return self
    end

    function component:GetText()
        return textbox.Text
    end

    function component:SetPlaceholder(text)
        textbox.PlaceholderText =
            tostring(text or "")

        return self
    end

    return self:_Add(
        component,
        name
    )
end

function SectionMethods:CreateKeybind(config)
    config = config or {}

    local name = tostring(
        config.Name or "Keybind"
    )

    local currentKey =
        config.Default
        or Enum.KeyCode.Unknown

    local callback = config.Callback
    local changedCallback =
        config.ChangedCallback

    local listening = false

    local frame = self:_CreateBase(
        config,
        38
    )

    local label = Create("TextLabel", {
        Size = UDim2.new(
            0.55,
            0,
            1,
            0
        ),

        Position = UDim2.new(
            0,
            11,
            0,
            0
        ),

        BackgroundTransparency = 1,

        Text = name,

        TextColor3 =
            self.Window.Theme.TextPrimary,

        TextSize = 12,

        Font = self.Window.Theme.Font,

        TextXAlignment =
            Enum.TextXAlignment.Left,

        Parent = frame,
    })

    local keyButton = Create("TextButton", {
        Size = UDim2.new(
            0,
            110,
            0,
            28
        ),

        Position = UDim2.new(
            1,
            -121,
            0.5,
            -14
        ),

        BackgroundColor3 =
            self.Window.Theme.Track,

        BorderSizePixel = 0,

        Text = tostring(
            currentKey.Name
        ),

        TextColor3 =
            self.Window.Theme.TextPrimary,

        TextSize = 10,

        Font = self.Window.Theme.Font,

        AutoButtonColor = false,

        Parent = frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                4
            ),
        }),
    })

    local component = Component.new(
        self.Window,
        frame
    )

    function component:SetKey(key)
        if typeof(key) ~= "EnumItem" then
            return self
        end

        currentKey = key

        keyButton.Text =
            key.Name

        SafeCallback(
            changedCallback,
            key
        )

        return self
    end

    function component:GetKey()
        return currentKey
    end

    component:_Connect(
        keyButton.MouseButton1Click,
        function()
            listening = true

            keyButton.Text = "PRESS KEY"

            self.Window:_Tween(
                keyButton,
                nil,
                {
                    BackgroundColor3 =
                        self.Window.Theme.ElementHover,
                }
            )
        end
    )

    component:_Connect(
        UserInputService.InputBegan,
        function(input, processed)
            if not listening then
                return
            end

            if input.UserInputType ==
                Enum.UserInputType.Keyboard then

                listening = false

                component:SetKey(
                    input.KeyCode
                )

                self.Window:_Tween(
                    keyButton,
                    nil,
                    {
                        BackgroundColor3 =
                            self.Window.Theme.Track,
                    }
                )

                return
            end

            if input.UserInputType ==
                Enum.UserInputType.MouseButton1
                or input.UserInputType ==
                Enum.UserInputType.MouseButton2
                or input.UserInputType ==
                Enum.UserInputType.MouseButton3 then

                listening = false

                component:SetKey(
                    input.UserInputType
                )

                self.Window:_Tween(
                    keyButton,
                    nil,
                    {
                        BackgroundColor3 =
                            self.Window.Theme.Track,
                    }
                )
            end
        end
    )

    component:_Connect(
        UserInputService.InputBegan,
        function(input, processed)
            if processed or listening then
                return
            end

            if input.KeyCode ==
                currentKey then

                SafeCallback(
                    callback
                )
            end
        end
    )

    return self:_Add(
        component,
        name
    )
end

function SectionMethods:CreateColorPicker(config)
    config = config or {}

    local name = tostring(
        config.Name or "Color"
    )

    local color =
        ClampColor(
            config.Default
            or Color3.new(1, 1, 1)
        )

    local callback = config.Callback

    local frame = self:_CreateBase(
        config,
        38
    )

    local label = Create("TextLabel", {
        Size = UDim2.new(
            0.6,
            0,
            1,
            0
        ),

        Position = UDim2.new(
            0,
            11,
            0,
            0
        ),

        BackgroundTransparency = 1,

        Text = name,

        TextColor3 =
            self.Window.Theme.TextPrimary,

        TextSize = 12,

        Font = self.Window.Theme.Font,

        TextXAlignment =
            Enum.TextXAlignment.Left,

        Parent = frame,
    })

    local swatch = Create("TextButton", {
        Size = UDim2.new(
            0,
            56,
            0,
            26
        ),

        Position = UDim2.new(
            1,
            -67,
            0.5,
            -13
        ),

        BackgroundColor3 = color,

        BorderSizePixel = 0,

        Text = "",

        AutoButtonColor = false,

        Parent = frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                4
            ),
        }),

        Create("UIStroke", {
            Color =
                self.Window.Theme.Stroke,

            Thickness = 1,
        }),
    })

    local picker = Create("Frame", {
        Size = UDim2.new(
            1,
            0,
            0,
            0
        ),

        Position = UDim2.new(
            0,
            0,
            1,
            3
        ),

        BackgroundColor3 =
            self.Window.Theme.Topbar,

        BorderSizePixel = 0,

        ClipsDescendants = true,

        Parent = frame,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                4
            ),
        }),
    })

    local rBox = Create("TextBox", {
        Size = UDim2.new(
            0.27,
            -4,
            0,
            28
        ),

        Position = UDim2.new(
            0,
            6,
            0,
            7
        ),

        BackgroundColor3 =
            self.Window.Theme.Track,

        BorderSizePixel = 0,

        TextColor3 =
            self.Window.Theme.TextPrimary,

        TextSize = 11,

        Font = self.Window.Theme.Font,

        Text = "255",

        Parent = picker,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                4
            ),
        }),
    })

    local gBox = rBox:Clone()
    gBox.Parent = picker
    gBox.Position = UDim2.new(
        0.33,
        0,
        0,
        7
    )
    gBox.Text = "255"

    local bBox = rBox:Clone()
    bBox.Parent = picker
    bBox.Position = UDim2.new(
        0.66,
        -6,
        0,
        7
    )
    bBox.Text = "255"

    local applyButton = Create("TextButton", {
        Size = UDim2.new(
            1,
            -12,
            0,
            28
        ),

        Position = UDim2.new(
            0,
            6,
            0,
            42
        ),

        BackgroundColor3 =
            self.Window.Theme.ElementBG,

        BorderSizePixel = 0,

        Text = "APPLY",

        TextColor3 =
            self.Window.Theme.TextPrimary,

        TextSize = 11,

        Font = self.Window.Theme.Font,

        AutoButtonColor = false,

        Parent = picker,
    }, {
        Create("UICorner", {
            CornerRadius = UDim.new(
                0,
                4
            ),
        }),
    })

    local component = Component.new(
        self.Window,
        frame
    )

    local opened = false

    local function getByte(box)
        local value =
            tonumber(box.Text)

        return math.clamp(
            math.round(value or 0),
            0,
            255
        )
    end

    function component:SetColor(newColor, fireCallback)
        if typeof(newColor) ~= "Color3" then
            return self
        end

        color = ClampColor(
            newColor
        )

        swatch.BackgroundColor3 =
            color

        rBox.Text = tostring(
            math.round(color.R * 255)
        )

        gBox.Text = tostring(
            math.round(color.G * 255)
        )

        bBox.Text = tostring(
            math.round(color.B * 255)
        )

        if fireCallback ~= false then
            SafeCallback(
                callback,
                color
            )
        end

        return self
    end

    function component:GetColor()
        return color
    end

    function component:Open()
        if opened then
            return self
        end

        opened = true

        self.Window:_Tween(
            picker,
            nil,
            {
                Size = UDim2.new(
                    1,
                    0,
                    0,
                    77
                ),
            }
        )

        self.Window:_Tween(
            frame,
            nil,
            {
                Size = UDim2.new(
                    1,
                    0,
                    0,
                    118
                ),
            }
        )

        return self
    end

    function component:Close()
        if not opened then
            return self
        end

        opened = false

        self.Window:_Tween(
            picker,
            nil,
            {
                Size = UDim2.new(
                    1,
                    0,
                    0,
                    0
                ),
            }
        )

        self.Window:_Tween(
            frame,
            nil,
            {
                Size = UDim2.new(
                    1,
                    0,
                    0,
                    38
                ),
            }
        )

        return self
    end

    component:_Connect(
        swatch.MouseButton1Click,
        function()
            if opened then
                component:Close()
            else
                component:Open()
            end
        end
    )

    component:_Connect(
        applyButton.MouseButton1Click,
        function()
            local newColor =
                Color3.fromRGB(
                    getByte(rBox),
                    getByte(gBox),
                    getByte(bBox)
                )

            component:SetColor(
                newColor,
                true
            )

            component:Close()
        end
    )

    component:SetColor(
        color,
        false
    )

    return self:_Add(
        component,
        name
    )
end

-- ============================================================
-- Legacy aliases
-- ============================================================

function SectionMethods:AddLabel(config)
    return self:CreateLabel(config)
end

function SectionMethods:AddButton(config)
    return self:CreateButton(config)
end

function SectionMethods:AddToggle(config)
    return self:CreateToggle(config)
end

function SectionMethods:AddSlider(config)
    return self:CreateSlider(config)
end

function SectionMethods:AddDropdown(config)
    return self:CreateDropdown(config)
end

function SectionMethods:AddTextbox(config)
    return self:CreateTextbox(config)
end

function SectionMethods:AddKeybind(config)
    return self:CreateKeybind(config)
end

function SectionMethods:AddColorPicker(config)
    return self:CreateColorPicker(config)
end

setmetatable(
    Component,
    {
        __index = SectionMethods,
    }
)

-- ============================================================
-- Fix Section inheritance
-- ============================================================

function Tab:CreateSection(title)
    title = tostring(title or "SECTION")

    local section = setmetatable({
        Window = self.Window,
        Tab = self,
        Name = title,
        Components = {},
        Destroyed = false,
    }, {
        __index = SectionMethods,
    })

    local frame = Create("Frame", {
        Name = title .. "_Section",

        Size = UDim2.new(
            1,
            0,
            0,
            0
        ),

        AutomaticSize =
            Enum.AutomaticSize.Y,

        BackgroundColor3 =
            self.Window.Theme.Background,

        BorderSizePixel = 0,

        Parent = self.Content,
    }, {
        Create("UICorner", {
            CornerRadius =
                self.Window.Theme.CornerRadius,
        }),

        Create("UIStroke", {
            Color =
                self.Window.Theme.Stroke,

            Thickness = 1,
        }),

        Create("UIPadding", {
            PaddingTop = UDim.new(
                0,
                11
            ),

            PaddingBottom = UDim.new(
                0,
                11
            ),

            PaddingLeft = UDim.new(
                0,
                11
            ),

            PaddingRight = UDim.new(
                0,
                11
            ),
        }),

        Create("UIListLayout", {
            SortOrder =
                Enum.SortOrder.LayoutOrder,

            Padding = UDim.new(
                0,
                7
            ),
        }),
    })

    section.Frame = frame
    section.Object = frame

    local header = Create("TextLabel", {
        Size = UDim2.new(
            1,
            0,
            0,
            18
        ),

        BackgroundTransparency = 1,

        Text = title:upper(),

        TextColor3 =
            self.Window.Theme.TextSecondary,

        TextSize = 11,

        Font =
            self.Window.Theme.TitleFont,

        TextXAlignment =
            Enum.TextXAlignment.Left,

        LayoutOrder = 0,

        Parent = frame,
    })

    section.Header = header

    function section:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        for _, component in ipairs(
            self.Components
        ) do
            if component.Destroy then
                component:Destroy()
            end
        end

        table.clear(self.Components)

        if self.Frame then
            self.Frame:Destroy()
        end
    end

    table.insert(
        self.Sections,
        section
    )

    return section
end

-- ============================================================
-- Convenience API
-- ============================================================

function Library:SetTheme(theme)
    for _, window in ipairs(
        self.Windows
    ) do
        window:SetTheme(theme)
    end
end

function Library:SetAccent(color)
    for _, window in ipairs(
        self.Windows
    ) do
        window:SetAccent(color)
    end
end

function Library:Notify(config)
    local window =
        self.Windows[#self.Windows]

    if window then
        return window:Notify(config)
    end
end

function Library:DestroyAll()
    local windows = table.clone(
        self.Windows
    )

    for _, window in ipairs(
        windows
    ) do
        window:Destroy()
    end
end

-- ============================================================
-- Preset Themes
-- ============================================================

function Library:GetTheme(name)
    name = tostring(name or "")

    if self.Themes[name] then
        return DeepCopy(
            self.Themes[name]
        )
    end

    return nil
end

function Library:AddTheme(name, theme)
    name = tostring(name or "")

    if name == "" or typeof(theme) ~= "table" then
        return false
    end

    self.Themes[name] = Merge(
        self.Themes.Dark,
        theme
    )

    return true
end

-- ============================================================
-- Return Library
-- ============================================================

return Library
